---
/**
 * PostHeader.astro — Blog post title header block
 *
 * Renders the top section of an individual post page: topic chips (linked to
 * /topics/[slug]/), the post title H1, publish date, and reading time.
 *
 * Used in: BlogLayout.astro (always rendered above the article body)
 *
 * Topic chips:
 *  Each chip is an anchor linking to /topics/[slug]/ via the shared
 *  `topicToSlug` util — matches the slug format generated by
 *  topics/[topic].astro's getStaticPaths() and Tag.astro. Trailing slash
 *  matches the site canonical convention (decision-log 2026-04-17).
 *
 * Reading time:
 *  Defaults to 5 minutes when no `readingTime` prop is supplied. Previously
 *  this fell back to `calculateReadingTime(tldr)` which computed minutes from
 *  a 1-2 sentence string and returned ~1 — misleading for Sanity posts that
 *  omit the field. The Zod schema defaults local posts to 5, so this fallback
 *  only fires for Sanity posts; aligning the default keeps the displayed
 *  number sensible until Sanity adds explicit values.
 */

import { topicToSlug } from '../../lib/utils/slugify';

interface Props {
  title: string;
  publishedAt: string;
  topics: string[];
  tldr: string;
  readingTime?: number;
  mainImage?: string;
}

const { title, publishedAt, topics, readingTime: readingTimeProp } = Astro.props;
const formattedDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const readingTime = readingTimeProp ?? 5;
---

<header class="space-y-5 pt-16 pb-10 lg:pt-20 lg:pb-12">
  <!-- Kicker: primary topic (linked to its /topics page) -->
  {topics.length > 0 && (
    <a
      href={`/topics/${topicToSlug(topics[0])}/`}
      class="inline-block text-[11px] font-mono uppercase tracking-[0.25em] text-accent hover:text-text-primary transition-colors"
    >
      {topics[0]}
    </a>
  )}

  <!-- Display headline -->
  <h1 class="font-display text-[2.25rem] sm:text-5xl lg:text-6xl font-semibold text-text-primary leading-[1.05] tracking-tight">
    {title}
  </h1>

  <!-- Byline rule: date · reading time · remaining topics -->
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[13px] text-text-muted border-t border-border-subtle pt-5">
    <time datetime={publishedAt} class="text-text-secondary">{formattedDate}</time>
    <span class="text-border-subtle" aria-hidden="true">·</span>
    <span>{readingTime} min read</span>
    {topics.length > 1 && (
      <>
        <span class="text-border-subtle" aria-hidden="true">·</span>
        <div class="flex flex-wrap gap-x-2.5 gap-y-1">
          {topics.slice(1).map(topic => (
            <a href={`/topics/${topicToSlug(topic)}/`} class="hover:text-accent transition-colors">#{topic}</a>
          ))}
        </div>
      </>
    )}
  </div>
</header>
