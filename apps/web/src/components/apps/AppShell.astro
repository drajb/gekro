---
import AttributionFooter from './AttributionFooter.astro';
import ExportButton from './shared/ExportButton.astro';
import CopyButton from './shared/CopyButton.astro';
import ResetButton from './shared/ResetButton.astro';
import { getCollection } from 'astro:content';
import { MIN_APPS_FOR_HUB, categoryHubUrl } from '../../lib/utils/apps-seo';

interface Props {
  title: string;
  job: string;
  category: string;
  slug: string;
  lastVerified?: string;
  companionPostSlug?: string;
  license?: string;
  exportFilename?: string;
}

const {
  title,
  job,
  category,
  slug,
  lastVerified,
  companionPostSlug,
  license = 'MIT',
  exportFilename = `${slug}-export.csv`,
} = Astro.props;

// The category kicker links to its hub page when one is built for it.
const liveApps = await getCollection('apps', ({ data }) => data.status !== 'archived');
const hubHref = liveApps.filter(a => a.data.category === category).length >= MIN_APPS_FOR_HUB ? categoryHubUrl(category) : null;
const categoryLabels: Record<string, string> = {
  ai: 'AI', infra: 'Infra', ev: 'EV', trading: 'Trading', dev: 'Dev', finance: 'Finance',
  fun: 'Fun', health: 'Health',
};
---

<div class="space-y-8">
  <!-- Header -->
  <div class="space-y-4">
    <div class="flex items-center gap-3">
      {hubHref ? (
        <a href={hubHref} class="text-[11px] font-mono uppercase tracking-[0.25em] text-accent hover:underline underline-offset-4">
          {categoryLabels[category] ?? category} tools
        </a>
      ) : (
        <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-accent">
          {categoryLabels[category] ?? category}
        </span>
      )}
    </div>
    <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-text-primary tracking-tight">{title}</h1>
    <p class="text-text-secondary text-lg leading-relaxed max-w-2xl">{job}</p>
  </div>

  <!-- Toolbar — wraps to 2 rows on phones; pill buttons stay tappable -->
  <div class="flex flex-wrap items-center gap-2 sm:gap-3 py-3 sm:py-4 border-y border-border-subtle">
    <ExportButton filename={exportFilename} />
    <CopyButton label="Copy Result" />
    <button
      id="btn-share"
      class="inline-flex items-center gap-2 px-4 py-2.5 sm:py-2 rounded-full bg-bg-elevated border border-border
             text-xs sm:text-[10px] font-mono uppercase tracking-widest text-text-secondary
             hover:border-accent hover:text-accent transition-all
             min-h-[40px] sm:min-h-0"
      aria-label="Share link"
    >
      ⤢ <span id="share-label">Share Link</span>
    </button>
    <ResetButton />
  </div>

  <!-- Calculator island slot -->
  <div class="relative py-4" id="calculator-island" style="opacity: 0;">
    <!-- Ambient Underglow -->
    <div class="absolute inset-x-0 -top-20 -bottom-20 bg-[radial-gradient(ellipse_at_center,var(--color-accent)_0%,transparent_60%)] opacity-5 pointer-events-none" aria-hidden="true"></div>
    
    <div class="relative z-10 glass-island">
      <slot />
    </div>
  </div>

  <!-- Methodology link -->
  {companionPostSlug && (
    <div class="pt-4">
      <a
        href={`/blog/${companionPostSlug}/`}
        class="inline-flex items-center gap-2 text-sm font-mono text-text-muted hover:text-accent transition-colors group"
      >
        Read the methodology
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  )}

  <!-- Attribution -->
  <AttributionFooter license={license} slug={slug} />
</div>

<script>
  const initShareButton = () => {
    const btn = document.getElementById('btn-share');
    const label = document.getElementById('share-label');
    if (!btn || (btn as any)._shareInit) return;
    (btn as any)._shareInit = true;

    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      if (label) { label.textContent = 'Copied!'; }
      setTimeout(() => { if (label) label.textContent = 'Share Link'; }, 1500);
    });
  };

  const initAppAnimations = async () => {
    const island = document.getElementById('calculator-island');
    if (!island || (island as any)._animInit) return;
    (island as any)._animInit = true;

    try {
      const { gsap } = await import('gsap');
      gsap.to(island, { opacity: 1, duration: 0.1 });
      // Reduced motion: show the app straight away, no entrance movement.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        island.style.opacity = '1';
        return;
      }

      const targets = island.querySelectorAll('.glass-island > div > *, .glass-island > * > div, input, select, button');
      if(targets.length > 0) {
        gsap.from(targets, {
          y: 20,
          opacity: 0,
          // 0.02 s per element, but never more than 0.6 s in total: a 169-cell or
          // 480-cell game board otherwise stays invisible for several seconds.
          stagger: Math.min(0.02, 0.6 / targets.length),
          ease: "power2.out",
          duration: 0.4,
          // Only what this tween sets. "all" also wiped inline styles an app puts on
          // these elements (CSS variables for grid sizes, tile positions), which
          // silently broke layouts after the entrance animation finished.
          clearProps: "opacity,transform,translate,rotate,scale"
        });
      }
    } catch (e) {
      if(island) island.style.opacity = '1';
    }
  };

  // Holding Enter or Space on a button must act once, not once per key repeat. Without this a held key
  // restarts a game, resigns a chess game or fires every shot in a cannon game (22 games leaked it in review).
  // A button that really wants repeats (hold to nudge) opts out with data-allow-repeat.
  const initRepeatGuard = () => {
    const island = document.getElementById('calculator-island');
    if (!island || (island as any)._repeatInit) return;
    (island as any)._repeatInit = true;
    island.addEventListener('keydown', (e) => {
      if (!e.repeat || (e.key !== 'Enter' && e.key !== ' ')) return;
      const t = e.target as Element | null;
      // A held Enter in a one-line text box submits its form again and again; held Space still types spaces.
      const textBox = e.key === 'Enter' && t && t.matches && t.matches('input:not([type=checkbox]):not([type=radio]):not([type=range])') ? t : null;
      const b = textBox ?? (t && t.closest ? t.closest('button, [role="button"]') : null);
      if (!b || !island.contains(b) || b.hasAttribute('data-allow-repeat')) return;
      e.preventDefault();
      e.stopPropagation();
    }, true);
  };

  // Safety net for keyboard focus. When a player presses a button that hides its own panel (New game in a
  // result card) or disables itself, the browser drops focus to <body> and the next Tab starts at the top
  // of the page. A game should move focus itself; if it did not, this puts it on a usable control.
  const initFocusGuard = () => {
    const island = document.getElementById('calculator-island');
    if (!island || (island as any)._focusInit) return;
    (island as any)._focusInit = true;
    let last: HTMLElement | null = null;
    let lastAction = 0;
    island.addEventListener('focusin', (e) => { last = e.target as HTMLElement; });
    for (const type of ['keydown', 'pointerdown', 'click']) {
      island.addEventListener(type, () => { lastAction = Date.now(); }, true);
    }
    const usable = (el: HTMLElement | null): el is HTMLElement =>
      !!el && el.isConnected && el.getClientRects().length > 0 && !(el as HTMLButtonElement).disabled && !el.closest('[inert]');
    const check = () => {
      if (Date.now() - lastAction > 2500) return;
      const now = document.activeElement;
      if (now && now !== document.body && now !== document.documentElement) return;
      if (!last || usable(last)) return;
      const candidates = [...island.querySelectorAll<HTMLElement>('[tabindex="0"], button, [role="button"]')];
      const pick = candidates.find((el) => el.getAttribute('tabindex') === '0' && usable(el) && el.getAttribute('aria-disabled') !== 'true')
        ?? candidates.find((el) => usable(el) && el.getAttribute('aria-disabled') !== 'true');
      if (pick) pick.focus({ preventScroll: true });
    };
    let queued = 0;
    new MutationObserver(() => {
      if (queued) return;
      queued = window.setTimeout(() => { queued = 0; check(); }, 120);
    }).observe(island, { subtree: true, childList: true, attributes: true, attributeFilter: ['hidden', 'disabled', 'inert', 'style', 'class', 'aria-hidden'] });
  };

  initShareButton();
  initAppAnimations();
  initRepeatGuard();
  initFocusGuard();
  document.addEventListener('astro:after-swap', () => {
    initShareButton();
    initAppAnimations();
    initRepeatGuard();
    initFocusGuard();
  });
</script>
