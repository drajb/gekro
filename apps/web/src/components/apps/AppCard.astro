---
import AppIcon from './AppIcon.astro';

interface Props {
  title: string;
  job: string;
  category: string;
  icon?: string;
  status: string;
  slug: string;
  publishedAt: string;
}

const { title, job, category, icon, status, slug, publishedAt } = Astro.props;

// Category chips use ONLY locked design-system tokens (design_system 2026-05-03:
// "never invent new colors") — the previous raw blue/green/yellow/purple/orange
// Tailwind palette values were off-token. Chips also carry the category text,
// so the palette doesn't need to be 1:1 unique.
const categoryColors: Record<string, string> = {
  ai:      'border-accent/20 bg-accent/5 text-accent',
  infra:   'border-border bg-bg-elevated text-text-secondary',
  ev:      'border-accent-success/20 bg-accent-success/5 text-accent-success',
  health:  'border-accent-success/20 bg-accent-success/5 text-accent-success',
  trading: 'border-accent-warm/20 bg-accent-warm/5 text-accent-warm',
  finance: 'border-accent-warm/20 bg-accent-warm/5 text-accent-warm',
  dev:     'border-accent-danger/20 bg-accent-danger/5 text-accent-danger',
  fun:     'border-accent-danger/20 bg-accent-danger/5 text-accent-danger',
};

const categoryColor = categoryColors[category] ?? categoryColors.infra;
---

<a
  href={`/apps/${slug}/`}
  class="app-card group relative block p-6 bg-bg-surface border border-border rounded-xl
         transition-all duration-300 hover:border-accent hover:shadow-2xl hover:shadow-accent/5"
>
  <div class="relative z-10 space-y-4">
    <div class="flex items-start justify-between gap-3">
      <AppIcon slug={slug} fallback={icon} size={28} class="text-accent shrink-0" />
      <div class="flex flex-wrap gap-2 ml-auto">
        <span class={`text-[10px] uppercase tracking-wider font-mono border px-2 py-0.5 rounded-full ${categoryColor}`}>
          {category}
        </span>
        {status !== 'active' && (
          <span class="text-[10px] uppercase tracking-wider font-mono border border-text-muted/20 bg-text-muted/5 text-text-muted px-2 py-0.5 rounded-full">
            {status}
          </span>
        )}
      </div>
    </div>

    <div class="space-y-1.5">
      <h3 class="text-lg font-heading font-medium text-text-primary group-hover:text-accent transition-colors">
        {title}
      </h3>
      <p class="text-sm text-text-secondary leading-relaxed">{job}</p>
    </div>

    <div class="pt-4 border-t border-border flex justify-between items-center text-xs text-text-secondary">
      <time datetime={publishedAt} class="font-mono">
        {new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <span class="group-hover:translate-x-1 transition-transform text-accent inline-flex items-center gap-1">
        Open <span class="text-base">→</span>
      </span>
    </div>
  </div>
</a>

