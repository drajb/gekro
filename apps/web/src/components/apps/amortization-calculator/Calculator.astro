---
// Amortization Calculator — pure client-side math, no deps
// Features: start-date payoff projection, one-time lump-sum payments,
// monthly vs bi-weekly payment schedule comparison
---

<div id="am-app" class="space-y-6">

  <!-- Loan basics -->
  <div class="space-y-2">
    <p class="text-[10px] font-mono uppercase tracking-widest text-text-secondary">Loan basics</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

      <div class="space-y-1.5">
        <label for="am-principal" class="text-sm font-medium text-text-secondary">Loan amount ($)</label>
        <input id="am-principal" type="number" min="0" step="1000" value="300000"
          class="w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:border-accent transition-colors" />
      </div>

      <div class="space-y-1.5">
        <label for="am-rate" class="text-sm font-medium text-text-secondary">Annual interest rate (%)<span title="The APR (Annual Percentage Rate) — the yearly cost of the loan as a percentage. Divided by payments-per-year internally to get the per-period rate." class="ml-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full border border-text-muted/30 text-[8px] text-text-muted cursor-help hover:border-accent/50 hover:text-accent transition-colors select-none">?</span></label>
        <input id="am-rate" type="number" min="0" max="30" step="0.01" value="6.5"
          class="w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:border-accent transition-colors" />
      </div>

      <div class="space-y-1.5">
        <label for="am-term" class="text-sm font-medium text-text-secondary">Loan term (years)<span title="The number of years to fully repay the loan. Common: 30 yr (lower payment, more interest) or 15 yr (higher payment, far less total interest). A 30-yr loan at the same rate costs roughly 2× the interest of a 15-yr." class="ml-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full border border-text-muted/30 text-[8px] text-text-muted cursor-help hover:border-accent/50 hover:text-accent transition-colors select-none">?</span></label>
        <input id="am-term" type="number" min="1" max="50" step="1" value="30"
          class="w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:border-accent transition-colors" />
      </div>

      <div class="space-y-1.5">
        <label for="am-start" class="text-sm font-medium text-text-secondary">Loan start date<span title="The date the loan was originated (or will be). Used to compute the actual payoff date — useful for picking a refinance window, planning around a target date, or seeing how 'time saved' translates to 'months earlier'." class="ml-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full border border-text-muted/30 text-[8px] text-text-muted cursor-help hover:border-accent/50 hover:text-accent transition-colors select-none">?</span></label>
        <input id="am-start" type="date"
          class="w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:border-accent transition-colors" />
      </div>

    </div>
  </div>

  <!-- Strategy -->
  <div class="space-y-2">
    <p class="text-[10px] font-mono uppercase tracking-widest text-text-secondary">Payoff strategy</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

      <div class="space-y-1.5">
        <label for="am-extra" class="text-sm font-medium text-text-secondary">Extra monthly payment ($)<span title="Additional principal paid each month on top of your required payment. Goes directly to reducing the balance, which cuts total interest and shortens the loan term. Bi-weekly's advantage actually comes from this same mechanism — paying half twice a month adds up to ~1 extra payment per year." class="ml-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full border border-text-muted/30 text-[8px] text-text-muted cursor-help hover:border-accent/50 hover:text-accent transition-colors select-none">?</span></label>
        <input id="am-extra" type="number" min="0" step="50" value="0"
          class="w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-text-primary focus:outline-none focus:border-accent transition-colors" />
        <p class="text-xs text-text-secondary">Additional principal per month. Reduces term and total interest.</p>
      </div>

      <div class="space-y-1.5">
        <label class="text-sm font-medium text-text-secondary">Payment frequency<span title="Monthly: 12 payments per year at the full monthly amount. Bi-weekly: 26 half-payments per year (every 2 weeks) — works out to ~13 monthly equivalents per year, knocking 4-8 years off a 30-year mortgage at typical rates because the extra annual payment goes entirely to principal." class="ml-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full border border-text-muted/30 text-[8px] text-text-muted cursor-help hover:border-accent/50 hover:text-accent transition-colors select-none">?</span></label>
        <div class="flex gap-1 p-1 bg-bg-elevated border border-border rounded-lg">
          <button class="am-freq app-btn-tab active flex-1 px-3 py-1.5 rounded-md text-xs" data-freq="monthly">Monthly</button>
          <button class="am-freq app-btn-tab flex-1 px-3 py-1.5 rounded-md text-xs" data-freq="biweekly">Bi-weekly</button>
        </div>
        <p class="text-xs text-text-secondary">Bi-weekly = 26 half-payments/year ≈ 13 monthly equivalents.</p>
      </div>

    </div>
  </div>

  <!-- One-time payments -->
  <div class="space-y-2">
    <div class="flex items-center justify-between">
      <p class="text-[10px] font-mono uppercase tracking-widest text-text-secondary">One-time payments<span title="Lump-sum extra payments at specific months. Common scenarios: year-end bonus, tax refund, inheritance. Each one applies entirely to principal at that month's payment, accelerating payoff." class="ml-1 inline-flex items-center justify-center w-3.5 h-3.5 rounded-full border border-text-muted/30 text-[8px] text-text-muted cursor-help hover:border-accent/50 hover:text-accent transition-colors select-none">?</span></p>
      <button id="am-add-otp" class="app-btn-secondary px-3 py-1 rounded-md text-xs">+ Add lump-sum payment</button>
    </div>
    <div id="am-otp-list" class="space-y-2">
      <!-- Rendered by JS -->
    </div>
    <p id="am-otp-empty" class="text-xs text-text-muted italic">No lump-sum payments scheduled. Click "Add" above to simulate one (e.g., year-end bonus).</p>
  </div>

  <!-- Summary cards -->
  <div id="am-summary" class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <!-- Rendered by JS -->
  </div>

  <!-- Payment composition bar -->
  <div class="space-y-2">
    <p class="text-xs font-mono uppercase tracking-widest text-text-secondary">Payment composition (lifetime)</p>
    <div class="flex rounded-lg overflow-hidden h-3">
      <div id="am-bar-principal" class="h-full transition-all" style="background:var(--color-accent)"></div>
      <div id="am-bar-interest" class="h-full transition-all" style="background:var(--color-text-muted)"></div>
    </div>
    <div class="flex items-center gap-4 text-[11px] font-mono text-text-muted">
      <span><span style="color:var(--color-accent)">■</span> Principal</span>
      <span><span style="color:var(--color-text-muted)">■</span> Interest</span>
      <span id="am-bar-label" class="ml-auto"></span>
    </div>
  </div>

  <!-- Payoff / savings panel — always visible -->
  <div id="am-payoff-panel" class="p-4 bg-bg-elevated border border-border-subtle rounded-xl">
    <!-- Rendered by JS -->
  </div>

  <!-- Chart + Schedule side by side -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 items-start">

    <!-- Balance chart -->
    <div class="space-y-1.5">
      <p class="text-xs font-mono uppercase tracking-widest text-text-secondary px-1">Remaining balance over time</p>
      <div class="bg-bg-surface border border-border-subtle rounded-xl p-4">
        <svg id="am-chart" viewBox="0 0 500 210" class="w-full" style="overflow:visible;display:block;"></svg>
      </div>
    </div>

    <!-- Amortization schedule -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-between px-1">
        <p class="text-xs font-mono uppercase tracking-widest text-text-secondary">Schedule</p>
        <button id="am-toggle-table" class="text-[10px] font-mono text-text-muted hover:text-accent transition-colors">
          Show full period-by-period ↓
        </button>
      </div>
      <div class="overflow-x-auto rounded-xl border border-border-subtle">
        <table class="w-full text-sm" id="am-table">
          <thead>
            <tr class="border-b border-border-subtle bg-bg-elevated">
              <th class="px-4 py-2.5 text-left text-xs font-mono uppercase tracking-wider text-text-secondary" id="am-th-period">Year</th>
              <th class="px-4 py-2.5 text-right text-xs font-mono uppercase tracking-wider text-text-secondary">Principal</th>
              <th class="px-4 py-2.5 text-right text-xs font-mono uppercase tracking-wider text-text-secondary">Interest</th>
              <th class="px-4 py-2.5 text-right text-xs font-mono uppercase tracking-wider text-text-secondary">Balance</th>
            </tr>
          </thead>
          <tbody id="am-tbody" class="divide-y divide-border-subtle">
            <!-- Rendered by JS -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

</div>

<script>
  const fmt = (n: number, dec = 2) =>
    n.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });

  const fmtDuration = (months: number): string => {
    const yrs = Math.floor(months / 12);
    const mo  = Math.round(months % 12);
    if (mo === 0) return `${yrs} yr${yrs !== 1 ? 's' : ''}`;
    return `${yrs} yr${yrs !== 1 ? 's' : ''} ${mo} mo`;
  };

  const fmtDate = (d: Date) =>
    d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

  /** Add `months` months to a date, preserving day-of-month where possible. */
  const addMonths = (d: Date, months: number): Date => {
    const result = new Date(d);
    result.setMonth(result.getMonth() + Math.floor(months));
    const fractionalDays = (months - Math.floor(months)) * 30.4375;
    result.setDate(result.getDate() + Math.round(fractionalDays));
    return result;
  };

  interface PeriodRow {
    period: number;       // monotonic period number (1, 2, 3, ...)
    principal: number;
    interest: number;
    balance: number;
    extraOneTime: number; // extra applied this period from a lump-sum
  }
  interface YearRow { year: number; principal: number; interest: number; balance: number; }
  type Frequency = 'monthly' | 'biweekly';
  interface OneTimePayment { amount: number; atMonth: number; }

  interface AmResult {
    monthlyEquivalentPayment: number; // for display ("payment per month")
    perPeriodPayment: number;          // actual per-period payment (half if biweekly)
    totalInterest: number;
    totalPaid: number;
    periods: number;                   // total periods used
    months: number;                    // months equivalent for duration display
    yearRows: YearRow[];
    csvRows: PeriodRow[];
    payoffDate: Date | null;
    frequency: Frequency;
    oneTimeApplied: number;            // total $ of lump-sums actually applied
  }

  /**
   * Core amortization simulator. Handles monthly + biweekly + extra payments + one-time lumps.
   *
   * The "monthly equivalent payment" is the standard 30-year mortgage payment using the monthly
   * formula. That's what the user understands as "my payment". For biweekly we simulate 26
   * periods/year at HALF that payment — which is the real-world consumer biweekly approach
   * that adds ~1 extra full payment per year. The per-period interest accrual uses the simple
   * compounding annualRate / periodsPerYear (consistent with how lenders disclose biweekly).
   */
  const calcAmortization = (
    P: number, annualRate: number, termYears: number,
    extraMonthly: number, oneTime: OneTimePayment[], freq: Frequency,
    startDate: Date | null
  ): AmResult | null => {
    if (P <= 0 || termYears <= 0 || annualRate < 0) return null;

    // Always compute the "monthly equivalent" using the classic monthly formula.
    // This is what the user calls "my monthly payment" — bi-weekly pays half of this.
    const monthlyR = annualRate / 100 / 12;
    const monthlyN = termYears * 12;
    const monthlyEqPayment = monthlyR === 0
      ? P / monthlyN
      : P * monthlyR * Math.pow(1 + monthlyR, monthlyN) / (Math.pow(1 + monthlyR, monthlyN) - 1);

    const periodsPerYear = freq === 'biweekly' ? 26 : 12;
    const r = annualRate / 100 / periodsPerYear;
    const perPeriodPayment = freq === 'biweekly' ? monthlyEqPayment / 2 : monthlyEqPayment;
    const perPeriodExtra = freq === 'biweekly' ? extraMonthly / 2 : extraMonthly;
    const totalPayment = perPeriodPayment + perPeriodExtra;

    // Map one-time payments (defined by month) to period numbers. For biweekly a "month" is
    // approximately 2.167 periods — we apply the lump-sum at the period closest to the
    // requested month boundary, then never apply it again.
    const periodsPerMonth = periodsPerYear / 12;
    const oneTimeByPeriod: Map<number, number> = new Map();
    for (const otp of oneTime) {
      if (otp.amount <= 0 || otp.atMonth <= 0) continue;
      const targetPeriod = Math.round(otp.atMonth * periodsPerMonth);
      oneTimeByPeriod.set(targetPeriod, (oneTimeByPeriod.get(targetPeriod) ?? 0) + otp.amount);
    }

    let balance = P;
    let totalInterest = 0;
    let oneTimeApplied = 0;
    let period = 0;
    const csvRows: PeriodRow[] = [];

    // Period cap: 50 years × 26 periods = 1300, plus buffer
    const HARD_CAP = 2000;

    while (balance > 0.005 && period < HARD_CAP) {
      period++;
      const intPart = balance * r;
      let prinPart = Math.min(totalPayment - intPart, balance);
      if (prinPart <= 0) return null;

      // Apply one-time lump-sum at this period if any
      let lumpSum = oneTimeByPeriod.get(period) ?? 0;
      if (lumpSum > 0) {
        // Cap the lump sum at the remaining balance after the regular principal payment
        const remainingAfterRegular = balance - prinPart;
        const actualLump = Math.min(lumpSum, remainingAfterRegular);
        prinPart += actualLump;
        oneTimeApplied += actualLump;
        lumpSum = actualLump;
      }

      balance = Math.max(0, balance - prinPart);
      totalInterest += intPart;

      csvRows.push({ period, principal: prinPart, interest: intPart, balance, extraOneTime: lumpSum });
    }

    if (balance > 0.005) return null; // hit cap

    // Convert period count → months for duration display.
    // For biweekly: 26 periods/year → multiply by (12/26) to get equivalent months.
    const monthsEquivalent = period * (12 / periodsPerYear);

    // Roll up per-year rows. For biweekly, a "year" = 26 periods; for monthly, 12.
    const yearRows: YearRow[] = [];
    let yearPrincipal = 0, yearInterest = 0, yearEndBalance = P;
    for (let i = 0; i < csvRows.length; i++) {
      const row = csvRows[i];
      yearPrincipal += row.principal;
      yearInterest += row.interest;
      yearEndBalance = row.balance;
      const isYearEnd = ((i + 1) % periodsPerYear === 0) || (i === csvRows.length - 1);
      if (isYearEnd) {
        yearRows.push({
          year: yearRows.length + 1,
          principal: yearPrincipal,
          interest: yearInterest,
          balance: yearEndBalance,
        });
        yearPrincipal = 0; yearInterest = 0;
      }
    }

    const payoffDate = startDate ? addMonths(startDate, monthsEquivalent) : null;

    return {
      monthlyEquivalentPayment: monthlyEqPayment,
      perPeriodPayment,
      totalInterest,
      totalPaid: P + totalInterest,
      periods: period,
      months: monthsEquivalent,
      yearRows,
      csvRows,
      payoffDate,
      frequency: freq,
      oneTimeApplied,
    };
  };

  const summaryCard = (label: string, value: string, sub?: string, highlight = false) => `
    <div class="p-4 ${highlight ? 'bg-accent/5 border-accent/20' : 'bg-bg-surface border-border-subtle'} border rounded-xl space-y-1">
      <p class="text-xs font-mono uppercase tracking-widest text-text-secondary">${label}</p>
      <p class="text-xl font-heading font-semibold ${highlight ? 'text-accent' : 'text-text-primary'}">${value}</p>
      ${sub ? `<p class="text-[11px] text-text-muted">${sub}</p>` : ''}
    </div>`;

  // ── SVG balance chart ────────────────────────────────────────────────────────

  const renderChart = (principal: number, res: AmResult, baseRes: AmResult | null) => {
    const svg = document.getElementById('am-chart');
    if (!svg) return;

    const W = 500, H = 210;
    const PL = 68, PR = 12, PT = 14, PB = 36;
    const CW = W - PL - PR;
    const CH = H - PT - PB;

    // Use month-equivalent for x-axis so monthly vs biweekly are comparable.
    const periodsPerYearForRes = res.frequency === 'biweekly' ? 26 : 12;

    const toPoints = (r: AmResult) => {
      const ppy = r.frequency === 'biweekly' ? 26 : 12;
      const pts = [{ yr: 0, bal: principal }];
      r.yearRows.forEach(row => pts.push({ yr: row.year, bal: row.balance }));
      return pts;
    };
    const mainPts = toPoints(res);
    const basePts = baseRes ? toPoints(baseRes) : null;

    const maxYr = Math.max(res.months / 12, baseRes ? baseRes.months / 12 : 0);
    const xS = (yr: number) => PL + (yr / maxYr) * CW;
    const yS = (bal: number) => PT + CH * (1 - bal / principal);

    const yTicks = [0, 0.25, 0.5, 0.75, 1].map(f => principal * f);
    const xInterval = maxYr <= 10 ? 2 : maxYr <= 20 ? 5 : maxYr <= 35 ? 5 : 10;
    const xTicks: number[] = [];
    for (let y = 0; y <= maxYr; y += xInterval) xTicks.push(y);
    if (xTicks[xTicks.length - 1] < maxYr - 0.5) xTicks.push(Math.round(maxYr));

    const polyline = (pts: { yr: number; bal: number }[]) =>
      pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${xS(p.yr).toFixed(1)},${yS(p.bal).toFixed(1)}`).join(' ');

    const areaPath = (pts: { yr: number; bal: number }[]) => {
      const last = pts[pts.length - 1];
      return `${polyline(pts)} L${xS(last.yr).toFixed(1)},${yS(0).toFixed(1)} L${xS(0).toFixed(1)},${yS(0).toFixed(1)} Z`;
    };

    const fmtK = (n: number) =>
      n >= 1_000_000 ? `$${(n / 1_000_000).toFixed(1)}M`
      : n >= 1_000    ? `$${Math.round(n / 1_000)}k`
      : `$${Math.round(n)}`;

    svg.innerHTML = `
      <defs>
        <linearGradient id="amGradMain" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"/>
          <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.03"/>
        </linearGradient>
        ${basePts ? `<linearGradient id="amGradBase" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#52525b" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#52525b" stop-opacity="0.02"/>
        </linearGradient>` : ''}
        <clipPath id="amClip">
          <rect x="${PL}" y="${PT}" width="${CW}" height="${CH}"/>
        </clipPath>
      </defs>
      ${yTicks.map(v => `
        <line x1="${PL}" y1="${yS(v).toFixed(1)}" x2="${W - PR}" y2="${yS(v).toFixed(1)}"
              stroke="#27272a" stroke-width="1"/>
        <text x="${PL - 7}" y="${yS(v).toFixed(1)}" text-anchor="end" dominant-baseline="middle"
              font-family="monospace" font-size="10" fill="#8a8a93">${fmtK(v)}</text>
      `).join('')}
      ${xTicks.map(yr => `
        <text x="${xS(yr).toFixed(1)}" y="${(PT + CH + 18).toFixed(1)}" text-anchor="middle"
              font-family="monospace" font-size="10" fill="#8a8a93">yr ${yr}</text>
      `).join('')}
      <g clip-path="url(#amClip)">
        ${basePts ? `
          <path d="${areaPath(basePts)}" fill="url(#amGradBase)"/>
          <path d="${polyline(basePts)}" fill="none" stroke="#52525b" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.7"/>
        ` : ''}
        <path d="${areaPath(mainPts)}" fill="url(#amGradMain)"/>
        <path d="${polyline(mainPts)}" fill="none" stroke="#38bdf8" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </g>
      ${basePts ? `<circle cx="${xS(basePts[basePts.length-1].yr).toFixed(1)}" cy="${yS(0).toFixed(1)}"
        r="4" fill="#8a8a93" stroke="#15130e" stroke-width="2"/>` : ''}
      <circle cx="${xS(mainPts[mainPts.length-1].yr).toFixed(1)}" cy="${yS(0).toFixed(1)}"
        r="5" fill="#38bdf8" stroke="#15130e" stroke-width="2"/>
      ${basePts ? `
        <rect x="${PL + 6}" y="${PT + 6}" width="14" height="2.5" fill="#38bdf8" rx="1.5"/>
        <text x="${PL + 24}" y="${PT + 13}" font-family="monospace" font-size="9.5" fill="#a1a1aa">your scenario</text>
        <line x1="${PL + 6}" y1="${PT + 24}" x2="${PL + 20}" y2="${PT + 24}"
              stroke="#52525b" stroke-width="1.5" stroke-dasharray="4,3"/>
        <text x="${PL + 24}" y="${PT + 28}" font-family="monospace" font-size="9.5" fill="#71717a">standard monthly</text>
      ` : ''}
    `;
  };

  // ── App init ─────────────────────────────────────────────────────────────────

  const initAm = () => {
    const app = document.getElementById('am-app');
    if (!app || (app as any)._amInit) return;
    (app as any)._amInit = true;

    const principalEl  = document.getElementById('am-principal') as HTMLInputElement;
    const rateEl       = document.getElementById('am-rate') as HTMLInputElement;
    const termEl       = document.getElementById('am-term') as HTMLInputElement;
    const extraEl      = document.getElementById('am-extra') as HTMLInputElement;
    const startEl      = document.getElementById('am-start') as HTMLInputElement;
    const summaryEl    = document.getElementById('am-summary')!;
    const tbodyEl      = document.getElementById('am-tbody')!;
    const barPEl       = document.getElementById('am-bar-principal') as HTMLDivElement;
    const barIEl       = document.getElementById('am-bar-interest') as HTMLDivElement;
    const barLabel     = document.getElementById('am-bar-label')!;
    const payoffPanel  = document.getElementById('am-payoff-panel')!;
    const toggleBtn    = document.getElementById('am-toggle-table') as HTMLButtonElement;
    const thPeriod     = document.getElementById('am-th-period')!;
    const freqBtns     = app.querySelectorAll<HTMLButtonElement>('.am-freq');
    const otpListEl    = document.getElementById('am-otp-list')!;
    const otpEmptyEl   = document.getElementById('am-otp-empty')!;
    const otpAddBtn    = document.getElementById('am-add-otp') as HTMLButtonElement;

    // Default start date to today (YYYY-MM-DD format)
    const today = new Date();
    const todayIso = today.toISOString().slice(0, 10);
    if (!startEl.value) startEl.value = todayIso;

    let showFull = false;
    let lastResult: AmResult | null = null;
    let lastExtra = 0;
    let activeFreq: 'monthly' | 'biweekly' = 'monthly';
    let oneTimePayments: OneTimePayment[] = [];
    let otpIdCounter = 0;

    /** Render the one-time payments list. Each row has amount + month inputs + remove button. */
    const renderOtpList = () => {
      otpEmptyEl.style.display = oneTimePayments.length === 0 ? '' : 'none';
      otpListEl.innerHTML = oneTimePayments.map((otp, idx) => `
        <div class="otp-row flex flex-wrap items-center gap-2 p-2.5 bg-bg-elevated border border-border rounded-lg" data-otp-idx="${idx}">
          <span class="text-[10px] font-mono text-text-muted shrink-0">#${idx + 1}</span>
          <div class="flex items-center gap-1.5 flex-1 min-w-[140px]">
            <span class="text-xs text-text-secondary">$</span>
            <input class="otp-amount w-full bg-bg-base border border-border rounded px-2 py-1 text-xs font-mono text-text-primary focus:outline-none focus:border-accent transition-colors" type="number" min="0" step="100" value="${otp.amount}" placeholder="Amount" />
          </div>
          <span class="text-[10px] text-text-secondary shrink-0">at month</span>
          <input class="otp-month w-20 bg-bg-base border border-border rounded px-2 py-1 text-xs font-mono text-text-primary focus:outline-none focus:border-accent transition-colors" type="number" min="1" max="600" step="1" value="${otp.atMonth}" placeholder="12" />
          <button class="otp-remove text-text-muted hover:text-accent-danger transition-colors px-2 py-1 text-base leading-none" title="Remove this payment">×</button>
        </div>
      `).join('');

      // Wire row inputs
      otpListEl.querySelectorAll<HTMLElement>('.otp-row').forEach(row => {
        const idx = parseInt(row.dataset.otpIdx || '0', 10);
        const amountInput = row.querySelector<HTMLInputElement>('.otp-amount')!;
        const monthInput = row.querySelector<HTMLInputElement>('.otp-month')!;
        const removeBtn = row.querySelector<HTMLButtonElement>('.otp-remove')!;
        amountInput.addEventListener('input', () => {
          oneTimePayments[idx].amount = parseFloat(amountInput.value) || 0;
          recalc();
        });
        monthInput.addEventListener('input', () => {
          oneTimePayments[idx].atMonth = parseInt(monthInput.value, 10) || 1;
          recalc();
        });
        removeBtn.addEventListener('click', () => {
          oneTimePayments.splice(idx, 1);
          renderOtpList();
          recalc();
        });
      });
    };

    otpAddBtn.addEventListener('click', () => {
      otpIdCounter++;
      // Default: $5,000 lump-sum at month 12 (year-end bonus scenario)
      oneTimePayments.push({ amount: 5000, atMonth: 12 });
      renderOtpList();
      recalc();
    });

    freqBtns.forEach(btn => btn.addEventListener('click', () => {
      activeFreq = (btn.dataset.freq as 'monthly' | 'biweekly') || 'monthly';
      freqBtns.forEach(b => b.classList.toggle('active', b === btn));
      recalc();
    }));

    toggleBtn.addEventListener('click', () => {
      showFull = !showFull;
      toggleBtn.textContent = showFull ? 'Show yearly only ↑' : 'Show full period-by-period ↓';
      thPeriod.textContent = showFull ? (activeFreq === 'biweekly' ? 'Period (2-wk)' : 'Month') : 'Year';
      if (lastResult) renderTable(lastResult, showFull);
    });

    const renderTable = (res: AmResult, full: boolean) => {
      tbodyEl.innerHTML = (full ? res.csvRows : res.yearRows).map((r, i) => {
        const period = full ? (r as PeriodRow).period : (r as YearRow).year;
        const lumpNote = full && (r as PeriodRow).extraOneTime > 0
          ? ` <span class="text-[9px] text-accent-warm">(+$${fmt((r as PeriodRow).extraOneTime, 0)} lump)</span>`
          : '';
        return `<tr class="${i % 2 === 0 ? 'bg-bg-surface' : 'bg-bg-elevated'}">
          <td class="px-4 py-2 text-text-muted font-mono text-xs">${period}${lumpNote}</td>
          <td class="px-4 py-2 text-right text-text-secondary text-xs">$${fmt(r.principal)}</td>
          <td class="px-4 py-2 text-right text-text-muted text-xs">$${fmt(r.interest)}</td>
          <td class="px-4 py-2 text-right text-text-secondary text-xs">$${fmt(r.balance)}</td>
        </tr>`;
      }).join('');
    };

    const recalc = () => {
      const P     = parseFloat(principalEl.value);
      const rate  = parseFloat(rateEl.value);
      const term  = parseFloat(termEl.value);
      const extra = parseFloat(extraEl.value) || 0;
      const startDate = startEl.value ? new Date(startEl.value + 'T00:00:00') : null;
      lastExtra   = extra;

      const res  = calcAmortization(P, rate, term, extra, oneTimePayments, activeFreq, startDate);
      // Baseline: standard monthly, no extras, no one-time. Used for "compared to" framing.
      const isStandard = activeFreq === 'monthly' && extra === 0 && oneTimePayments.length === 0;
      const base = isStandard ? null : calcAmortization(P, rate, term, 0, [], 'monthly', startDate);
      lastResult = res;

      if (!res) {
        summaryEl.innerHTML = '<p class="text-text-muted text-sm col-span-4">Invalid inputs.</p>';
        return;
      }

      // ── Summary cards ──────────────────────────────────────────────────────
      const monthlyDisplay = activeFreq === 'biweekly'
        ? `$${fmt(res.perPeriodPayment + (extra / 2))}`
        : `$${fmt(res.monthlyEquivalentPayment + extra)}`;
      const monthlyDisplaySub = activeFreq === 'biweekly'
        ? `Bi-weekly. Monthly equiv: $${fmt(res.monthlyEquivalentPayment)}`
        : (extra > 0 ? `Base $${fmt(res.monthlyEquivalentPayment)} + $${fmt(extra)} extra` : undefined);

      summaryEl.innerHTML =
        summaryCard(
          activeFreq === 'biweekly' ? 'Bi-weekly payment' : 'Monthly payment',
          monthlyDisplay,
          monthlyDisplaySub
        ) +
        summaryCard('Total interest', `$${fmt(res.totalInterest)}`,
          base ? `Standard: $${fmt(base.totalInterest)}` : undefined) +
        summaryCard('Total paid',     `$${fmt(res.totalPaid)}`) +
        summaryCard(
          'Payoff in',
          fmtDuration(res.months),
          res.payoffDate ? `Date: ${fmtDate(res.payoffDate)}` : (base ? `Standard: ${fmtDuration(base.months)}` : undefined),
          !isStandard
        );

      // ── Composition bar ────────────────────────────────────────────────────
      const pct = (P / res.totalPaid) * 100;
      barPEl.style.width = pct + '%';
      barIEl.style.width = (100 - pct) + '%';
      barLabel.textContent = `${fmt(pct, 1)}% principal · ${fmt(100 - pct, 1)}% interest`;

      // ── Payoff panel ───────────────────────────────────────────────────────
      if (base) {
        const savedMonths   = base.months - res.months;
        const savedInterest = base.totalInterest - res.totalInterest;
        const baselinePayoff = base.payoffDate ? fmtDate(base.payoffDate) : null;
        const yourPayoff = res.payoffDate ? fmtDate(res.payoffDate) : null;

        // Build sub-rows describing what's contributing to savings
        const contributions: string[] = [];
        if (activeFreq === 'biweekly') contributions.push('bi-weekly schedule');
        if (extra > 0) contributions.push(`$${fmt(extra)}/mo extra`);
        if (res.oneTimeApplied > 0) contributions.push(`$${fmt(res.oneTimeApplied, 0)} in lump-sums`);
        const contribStr = contributions.length > 0
          ? contributions.join(' + ')
          : 'no acceleration';

        payoffPanel.style.borderColor = 'color-mix(in srgb, var(--color-accent) 25%, transparent)';
        payoffPanel.innerHTML = `
          <p class="text-xs font-mono uppercase tracking-widest text-text-secondary mb-3">Acceleration impact (${contribStr})</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="space-y-0.5">
              <p class="text-xs text-text-secondary">Your payoff</p>
              <p class="text-lg font-semibold text-accent">${fmtDuration(res.months)}</p>
              ${yourPayoff ? `<p class="text-[10px] text-text-muted font-mono">${yourPayoff}</p>` : ''}
            </div>
            <div class="space-y-0.5">
              <p class="text-xs text-text-secondary">Standard payoff</p>
              <p class="text-lg font-semibold text-text-primary">${fmtDuration(base.months)}</p>
              ${baselinePayoff ? `<p class="text-[10px] text-text-muted font-mono">${baselinePayoff}</p>` : ''}
            </div>
            <div class="space-y-0.5">
              <p class="text-xs text-text-secondary">Time saved</p>
              <p class="text-lg font-semibold text-accent-success">${fmtDuration(savedMonths)} earlier</p>
            </div>
          </div>
          <div class="mt-3 pt-3 border-t border-border-subtle text-sm text-text-secondary">
            💰 Saves <strong class="text-accent-success">$${fmt(savedInterest)}</strong> in total interest vs standard 30-yr monthly.
          </div>`;
      } else {
        payoffPanel.style.borderColor = '';
        const yourPayoff = res.payoffDate ? fmtDate(res.payoffDate) : null;
        payoffPanel.innerHTML = `
          <p class="text-xs font-mono uppercase tracking-widest text-text-secondary mb-2">Payoff timeline</p>
          <div class="flex flex-wrap items-end gap-6">
            <div class="space-y-0.5">
              <p class="text-xs text-text-secondary">Loan paid off in</p>
              <p class="text-2xl font-heading font-bold text-text-primary">${fmtDuration(res.months)}</p>
              ${yourPayoff ? `<p class="text-xs text-text-secondary mt-0.5">on <span class="text-text-primary font-mono">${yourPayoff}</span></p>` : ''}
            </div>
            <p class="text-sm text-text-secondary pb-1 max-w-xs">
              Switch to bi-weekly, add an extra payment, or schedule a lump-sum to see how much time and interest you'd save.
            </p>
          </div>`;
      }

      // ── Chart + Table ──────────────────────────────────────────────────────
      renderChart(P, res, base);
      renderTable(res, showFull);
    };

    [principalEl, rateEl, termEl, extraEl, startEl].forEach(el => {
      el.addEventListener('input', recalc);
      el.addEventListener('change', recalc);
    });
    renderOtpList();
    recalc();

    // ── AppShell events ─────────────────────────────────────────────────────────
    document.addEventListener('app:export', () => {
      if (!lastResult) return;
      const periodLabel = lastResult.frequency === 'biweekly' ? 'Period (2-wk)' : 'Month';
      const csv = [`${periodLabel},Principal,Interest,Balance,Lump-Sum Applied`,
        ...lastResult.csvRows.map(r =>
          `${r.period},${r.principal.toFixed(2)},${r.interest.toFixed(2)},${r.balance.toFixed(2)},${r.extraOneTime.toFixed(2)}`)
      ].join('\n');
      const a = Object.assign(document.createElement('a'), {
        href: URL.createObjectURL(new Blob([csv], { type: 'text/csv' })),
        download: `amortization-${new Date().toISOString().split('T')[0]}.csv`,
      });
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });

    document.addEventListener('app:copy', async () => {
      if (!lastResult) return;
      const r = lastResult;
      const monthly = activeFreq === 'biweekly'
        ? `Bi-weekly: $${fmt(r.perPeriodPayment)} (monthly equiv $${fmt(r.monthlyEquivalentPayment)})`
        : `Monthly: $${fmt(r.monthlyEquivalentPayment + lastExtra)}`;
      const dateStr = r.payoffDate ? `\nPayoff date: ${fmtDate(r.payoffDate)}` : '';
      const lumpStr = r.oneTimeApplied > 0 ? `\nLump-sums applied: $${fmt(r.oneTimeApplied)}` : '';
      const text = `${monthly}\nPayoff in: ${fmtDuration(r.months)}${dateStr}${lumpStr}\nTotal interest: $${fmt(r.totalInterest)}\nTotal paid: $${fmt(r.totalPaid)}`;
      try { await navigator.clipboard.writeText(text); } catch {}
    });

    document.addEventListener('app:reset', () => {
      principalEl.value = '300000';
      rateEl.value = '6.5';
      termEl.value = '30';
      extraEl.value = '0';
      startEl.value = todayIso;
      activeFreq = 'monthly';
      freqBtns.forEach(b => b.classList.toggle('active', b.dataset.freq === 'monthly'));
      oneTimePayments = [];
      renderOtpList();
      recalc();
    });
  };

  initAm();
  document.addEventListener('astro:after-swap', initAm);
</script>
