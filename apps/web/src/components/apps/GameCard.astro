---
/**
 * GameCard - a card on the /games/ hub and the genre pages.
 * Colour comes only from the locked design tokens; the genre chip also carries text.
 */
import AppIcon from './AppIcon.astro';
import { GENRES, itemUrl } from '../../lib/utils/games';
import type { GenreId } from '../../lib/utils/games';

interface Props {
  title: string;
  job: string;
  genre: GenreId;
  icon?: string;
  slug: string;
}

const { title, job, genre, icon, slug } = Astro.props;

const genreColors: Record<GenreId, string> = {
  board: 'border-accent/25 bg-accent/5 text-accent',
  cards: 'border-accent-danger/25 bg-accent-danger/5 text-accent-danger',
  puzzle: 'border-accent-success/25 bg-accent-success/5 text-accent-success',
  word: 'border-accent-warm/25 bg-accent-warm/5 text-accent-warm',
  arcade: 'border-accent-danger/25 bg-accent-danger/5 text-accent-danger',
  creative: 'border-accent/25 bg-accent/5 text-accent',
  learning: 'border-accent-success/25 bg-accent-success/5 text-accent-success',
};
---

<a
  href={itemUrl(slug)}
  class="game-card group relative flex h-full flex-col gap-3 p-5 bg-bg-surface border border-border rounded-xl
         transition-all duration-300 hover:border-accent hover:-translate-y-0.5 hover:shadow-xl hover:shadow-accent/5"
  data-genre={genre}
  data-title={title.toLowerCase()}
>
  <div class="flex items-start justify-between gap-3">
    <AppIcon slug={slug} fallback={icon} size={28} class="text-accent shrink-0" />
    <span class={`text-[10px] uppercase tracking-wider font-mono border px-2 py-0.5 rounded-full ${genreColors[genre]}`}>
      {GENRES[genre].label}
    </span>
  </div>
  <div class="space-y-1.5 flex-1">
    <h3 class="text-lg font-heading font-medium text-text-primary group-hover:text-accent transition-colors">{title}</h3>
    <p class="text-sm text-text-secondary leading-relaxed line-clamp-3">{job}</p>
  </div>
  <span class="text-xs text-accent inline-flex items-center gap-1 font-mono uppercase tracking-wider">
    Play <span class="group-hover:translate-x-1 transition-transform">→</span>
  </span>
</a>
