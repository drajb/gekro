---
/**
 * HeroCanvasNeural.astro — Full-viewport Three.js neural particle canvas
 *
 * Renders a floating neural-network particle field as the hero background.
 * Used on: homepage, about, contact, now pages.
 *
 * Architecture:
 *  - 150 particles in a 3D bounding box, each with random velocity
 *  - Pairs within CONNECT_DIST (15 units) are linked with semi-transparent lines
 *  - Camera rotates to follow mouse position (smooth lerp, factor 0.05)
 *  - WebGL renderer: pixel ratio capped at 1.5 to protect GPU on HiDPI screens
 *  - AdditiveBlending on both points and lines for the glowing neural look
 *
 * Colors:
 *  Hardcoded hex 0x3fb1ff — THREE.Color cannot consume CSS variables.
 *  This matches --color-accent in global.css. If the accent colour changes,
 *  update these hex literals too.
 *
 * Lifecycle / View Transitions:
 *  - astro:before-swap → destroyThree() — tears down renderer before DOM swap
 *    (prevents WebGL context leak and dangling animation frames)
 *  - astro:after-swap  → startThree()  — re-initialises after each swap
 *  - startThree() defers via requestIdleCallback to protect FCP/TBT
 *
 * Reduced motion:
 *  CSS hides #three-container and shows .fallback-gradient — AND startThree()
 *  bails before importing Three.js at all (2026-06-10). The old CSS-only
 *  approach kept a hidden WebGL scene rendering at 60fps for users who asked
 *  for less motion, and still downloaded the ~490KB module.
 */
---
<div id="neural-canvas-container" class="absolute inset-0 z-0 bg-bg-base pointer-events-auto overflow-hidden">
  <div id="three-container" class="w-full h-full"></div>
  <div class="fallback-gradient absolute inset-0 bg-gradient-to-br from-bg-base to-bg-elevated hidden"></div>
</div>

<style>
  #three-container {
    opacity: 0;
    transition: opacity 2s ease;
  }
  #three-container.ready {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    #three-container { display: none !important; }
    .fallback-gradient { display: block !important; }
  }
</style>

<script>
  // Dynamic import (2026-06-10): the static `import * as THREE` form made the
  // browser download the ~490KB module at page parse on every page mounting
  // this component — requestIdleCallback only deferred EXECUTION, not the
  // fetch. The type-only import below is erased at build, and the module is
  // fetched inside startThree()'s idle callback instead. The visual is
  // unchanged (decision 2026-04-01: the hero animation stays).
  import type * as THREE_NS from 'three';
  let THREE: typeof THREE_NS;

  let renderer: THREE_NS.WebGLRenderer | null = null;
  let scene: THREE_NS.Scene | null = null;
  let camera: THREE_NS.PerspectiveCamera | null = null;
  let points: THREE_NS.Points | null = null;
  let lines: THREE_NS.LineSegments | null = null;
  let animationId: number | null = null;
  let onMouseMoveRef: ((e: MouseEvent) => void) | null = null;
  let onResizeRef: (() => void) | null = null;
  let visObserver: IntersectionObserver | null = null;
  let isHeroVisible = true;

  const PARTICLE_COUNT = 150;
  const CONNECT_DIST = 15;
  const BOX_SIZE = 40;

  // ── Cursor repulsion: particles scatter away from the cursor in world space ──
  // REPULSION_RADIUS: distance in world units within which a particle feels force
  // REPULSION_STRENGTH: max displacement (world units) per frame when closest
  // The force uses inverse-square falloff, clamped by REPULSION_STRENGTH so
  // very-close particles don't fly out of the bounding box in a single frame.
  const REPULSION_RADIUS = 8;
  const REPULSION_STRENGTH = 0.15;

  /**
   * destroyThree — full teardown of the WebGL context and event listeners.
   *
   * Called before each View Transition swap (astro:before-swap) so the old
   * renderer is fully disposed before the DOM is replaced. Without this,
   * navigating between pages that mount HeroCanvasNeural would leak WebGL
   * contexts (browsers cap at ~8–16 contexts per page).
   *
   * forceContextLoss() is required in addition to dispose() to immediately
   * release the GPU context rather than waiting for GC.
   */
  const destroyThree = () => {
    if (animationId !== null) cancelAnimationFrame(animationId);
    animationId = null;
    visObserver?.disconnect();
    visObserver = null;
    if (onMouseMoveRef) window.removeEventListener('mousemove', onMouseMoveRef);
    if (onResizeRef) window.removeEventListener('resize', onResizeRef);
    onMouseMoveRef = null;
    onResizeRef = null;
    if (renderer) {
      renderer.dispose();
      renderer.forceContextLoss();
      renderer.domElement.remove();
    }
    renderer = null;
    scene = null;
    camera = null;
  };

  const initThree = () => {
    destroyThree();

    const container = document.getElementById('three-container');
    if (!container) return;

    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 30;

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    container.appendChild(renderer.domElement);

    // Particles
    const positions = new Float32Array(PARTICLE_COUNT * 3);
    const velocities = new Float32Array(PARTICLE_COUNT * 3);
    
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      positions[i * 3] = (Math.random() - 0.5) * BOX_SIZE;
      positions[i * 3 + 1] = (Math.random() - 0.5) * BOX_SIZE;
      positions[i * 3 + 2] = (Math.random() - 0.5) * BOX_SIZE;

      velocities[i * 3] = (Math.random() - 0.5) * 0.02;
      velocities[i * 3 + 1] = (Math.random() - 0.5) * 0.02;
      velocities[i * 3 + 2] = (Math.random() - 0.5) * 0.02;
    }

    const pointsGeometry = new THREE.BufferGeometry();
    pointsGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    
    // Hardcoded hex required — THREE.Color cannot consume CSS variables.
    // Must match --color-accent (#38bdf8 sky-400) from global.css. If the
    // accent is ever swapped in global.css, update this hex literal too.
    const pointsMaterial = new THREE.PointsMaterial({
      color: 0x38bdf8,
      size: 0.15,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending
    });

    points = new THREE.Points(pointsGeometry, pointsMaterial);
    scene.add(points);

    // Lines (Connectors) — same accent hex as the points above (was stale
    // pre-overhaul 0x3fb1ff while points used 0x38bdf8)
    const lineMaterial = new THREE.LineBasicMaterial({
      color: 0x38bdf8,
      transparent: true,
      opacity: 0.1,
      blending: THREE.AdditiveBlending
    });
    
    // Pre-allocate line position buffer at maximum possible size.
    // Max pairs = n*(n-1)/2 = 150*149/2 = 11,175; each pair = 2 points × 3 floats.
    // Writing in-place each frame eliminates the per-frame Float32Array allocation
    // and GC churn that the previous push()-then-new-BufferAttribute approach caused.
    const MAX_LINE_PAIRS = (PARTICLE_COUNT * (PARTICLE_COUNT - 1)) / 2;
    const lineBuffer = new Float32Array(MAX_LINE_PAIRS * 2 * 3);
    const linesGeometry = new THREE.BufferGeometry();
    const linePositionAttr = new THREE.BufferAttribute(lineBuffer, 3);
    linePositionAttr.setUsage(THREE.DynamicDrawUsage); // hint GPU: data changes every frame
    linesGeometry.setAttribute('position', linePositionAttr);
    lines = new THREE.LineSegments(linesGeometry, lineMaterial);
    scene.add(lines);

    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    // Cursor repulsion state — projected world-space position of the cursor
    // and a flag so the repulsion block only runs after the first mousemove
    // (avoids particles flocking to (0,0,0) at page load).
    const mouseWorld = new THREE.Vector3(0, 0, 0);
    let isMouseActive = false;

    onMouseMoveRef = (e: MouseEvent) => {
      // Existing scene-rotation values (whole field tilts toward the cursor)
      mouseX = (e.clientX - window.innerWidth / 2) / 100;
      mouseY = (e.clientY - window.innerHeight / 2) / 100;

      // Project mouse to world-space z=0 plane for per-particle repulsion.
      // Unproject NDC through the camera, then intersect the resulting ray
      // with z=0. z=0 is the median of the particle field ([-20, +20] per axis),
      // so particles at different depths feel proportionally different force —
      // produces a natural depth parallax.
      if (camera) {
        const ndcX = (e.clientX / window.innerWidth) * 2 - 1;
        const ndcY = -(e.clientY / window.innerHeight) * 2 + 1;
        const vec = new THREE.Vector3(ndcX, ndcY, 0.5);
        vec.unproject(camera);
        const dir = vec.sub(camera.position).normalize();
        const t = -camera.position.z / dir.z;
        mouseWorld.set(
          camera.position.x + dir.x * t,
          camera.position.y + dir.y * t,
          0
        );
        isMouseActive = true;
      }
    };

    window.addEventListener('mousemove', onMouseMoveRef, { passive: true });

    const animate = () => {
      if (!points || !scene || !camera || !renderer) return;
      // Suspend the O(n²) loop while the hero is scrolled out of view — the
      // IntersectionObserver below restarts it when it re-enters the viewport.
      if (!isHeroVisible) { animationId = null; return; }
      animationId = requestAnimationFrame(animate);

      // Smooth mouse follow
      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;
      
      scene.rotation.y = targetX * 0.2;
      scene.rotation.x = -targetY * 0.2;

      const posAttr = points.geometry.attributes.position;
      // lineIdx tracks write position in the pre-allocated lineBuffer.
      // Reset each frame; setDrawRange at the end limits rendering to active pairs.
      let lineIdx = 0;

      for (let i = 0; i < PARTICLE_COUNT; i++) {
        // Move particles
        posAttr.setX(i, posAttr.getX(i) + velocities[i * 3]);
        posAttr.setY(i, posAttr.getY(i) + velocities[i * 3 + 1]);
        posAttr.setZ(i, posAttr.getZ(i) + velocities[i * 3 + 2]);

        // Box bounce
        if (Math.abs(posAttr.getX(i)) > BOX_SIZE / 2) velocities[i * 3] *= -1;
        if (Math.abs(posAttr.getY(i)) > BOX_SIZE / 2) velocities[i * 3 + 1] *= -1;
        if (Math.abs(posAttr.getZ(i)) > BOX_SIZE / 2) velocities[i * 3 + 2] *= -1;

        // ── Cursor repulsion ──
        // Particles within REPULSION_RADIUS of the projected cursor get pushed
        // away with an inverse-square force (capped by REPULSION_STRENGTH so a
        // single-frame displacement can't exceed the box size). After the push
        // we clamp to the bounding box so nothing escapes. No velocity is
        // modified — particles naturally drift back into place via their
        // existing velocity field, giving a "water ripple" feel.
        if (isMouseActive) {
          const px = posAttr.getX(i);
          const py = posAttr.getY(i);
          const pz = posAttr.getZ(i);
          const rdx = px - mouseWorld.x;
          const rdy = py - mouseWorld.y;
          const rdz = pz - mouseWorld.z;
          const rDist = Math.sqrt(rdx * rdx + rdy * rdy + rdz * rdz);

          if (rDist < REPULSION_RADIUS && rDist > 0.01) {
            const force = REPULSION_STRENGTH / (rDist * rDist);
            const cappedForce = Math.min(force, REPULSION_STRENGTH);
            const nx = rdx / rDist;
            const ny = rdy / rDist;
            const nz = rdz / rDist;
            const half = BOX_SIZE / 2;
            posAttr.setX(i, Math.max(-half, Math.min(half, px + nx * cappedForce)));
            posAttr.setY(i, Math.max(-half, Math.min(half, py + ny * cappedForce)));
            posAttr.setZ(i, Math.max(-half, Math.min(half, pz + nz * cappedForce)));
          }
        }

        // Connections — write directly into the pre-allocated lineBuffer.
        // Avoids creating a new JS array and Float32Array allocation every frame.
        for (let j = i + 1; j < PARTICLE_COUNT; j++) {
          const dx = posAttr.getX(i) - posAttr.getX(j);
          const dy = posAttr.getY(i) - posAttr.getY(j);
          const dz = posAttr.getZ(i) - posAttr.getZ(j);
          const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

          if (dist < CONNECT_DIST) {
            lineBuffer[lineIdx++] = posAttr.getX(i);
            lineBuffer[lineIdx++] = posAttr.getY(i);
            lineBuffer[lineIdx++] = posAttr.getZ(i);
            lineBuffer[lineIdx++] = posAttr.getX(j);
            lineBuffer[lineIdx++] = posAttr.getY(j);
            lineBuffer[lineIdx++] = posAttr.getZ(j);
          }
        }
      }

      posAttr.needsUpdate = true;
      // Only render the line segments written this frame; leave the rest of the
      // buffer stale (it will be overwritten next frame before use).
      linesGeometry.setDrawRange(0, lineIdx / 3);
      linePositionAttr.needsUpdate = true;
      
      renderer.render(scene, camera);
    };

    // Pause rendering while the hero is offscreen (it kept burning a full
    // core at 60fps under long pages before this).
    isHeroVisible = true;
    visObserver = new IntersectionObserver(([entry]) => {
      const wasVisible = isHeroVisible;
      isHeroVisible = entry.isIntersecting;
      if (isHeroVisible && !wasVisible && animationId === null) animate();
    });
    visObserver.observe(container);

    animate();
    container.classList.add('ready');

    onResizeRef = () => {
      if (!camera || !renderer) return;
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    };
    window.addEventListener('resize', onResizeRef);
  };

  /**
   * startThree — defers initThree() to idle time to protect FCP/TBT.
   *
   * requestIdleCallback fires after the browser finishes painting; the 2000ms
   * timeout is a safety net for browsers that delay idle callbacks indefinitely.
   * Falls back to setTimeout(500) for browsers without requestIdleCallback.
   */
  const startThree = () => {
    // Reduced-motion users see the CSS fallback gradient — skip the ~490KB
    // module download and the render loop entirely.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const boot = async () => {
      // Fetch Three.js now (idle time), not at page parse.
      if (!THREE) THREE = await import('three');
      initThree();
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => { boot(); }, { timeout: 2000 });
    } else {
      setTimeout(boot, 500);
    }
  };

  // Init on first load; destroy before each swap; re-init after each swap
  startThree();
  document.addEventListener('astro:before-swap', destroyThree);
  document.addEventListener('astro:after-swap', startThree);
</script>
