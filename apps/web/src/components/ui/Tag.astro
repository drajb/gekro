---
/**
 * Tag.astro — Topic chip / filter badge
 *
 * Used in: blog/index.astro (sidebar filter), index.astro (sidebar chip cloud)
 *
 * Each chip links to /topics/[slug]/ — slug derived via the shared
 * `topicToSlug` util (matches the slug format in topics/[topic].astro and
 * PostHeader). Trailing slash matches the site canonical convention
 * (decision-log 2026-04-17) so this href doesn't trigger a CF Pages 308.
 *
 * Props:
 *  title  — topic name (used as display text and for URL generation)
 *  count  — optional post count, shown in parentheses at reduced opacity
 *  active — when true, renders with solid accent fill (used for "All Posts")
 *
 * The filter click behaviour (client-side topic filtering on the archive page)
 * is handled by the SearchWidget, not by this component.
 */

import { topicToSlug } from '../../lib/utils/slugify';

interface Props {
  title: string;
  count?: number;
  active?: boolean;
}

const { title, count, active } = Astro.props;
---

<a
  href={`/topics/${topicToSlug(title)}/`}
  class={`px-4 py-2 rounded-full border transition-all duration-300 font-mono text-sm flex items-center gap-2 ${
    active 
      ? 'bg-accent text-bg-base border-accent' 
      : 'bg-bg-elevated text-text-secondary border-border hover:border-accent hover:text-accent'
  }`}
>
  {title}
  {count !== undefined && (
    /* opacity-60 removed 2026-05-03 — even with the bumped text-muted token
       (#8a8a93), 60% alpha drove the count badge below 2.5:1 against bg-base.
       The text-muted colour already conveys "secondary information"; the alpha
       reduction was just stacking emphasis loss. Full-opacity now reads ~5.8:1. */
    <span class={`text-[10px] ${active ? 'text-bg-base' : 'text-text-muted'}`}>
      ({count})
    </span>
  )}
</a>
