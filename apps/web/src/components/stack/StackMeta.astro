---
/**
 * StackMeta.astro — "At a glance" spec sheet for a /stack entry
 *
 * Renders structured facts about the tool — homepage, pricing, cross-links,
 * and the explicit alternatives list — as a grid of labelled tiles so the
 * block reads like a product spec sheet rather than a dense definition list.
 * Lives below the body content, just above the referral disclosure footer.
 *
 * If an alternative is the slug of another stack entry (alphanumeric + dashes
 * only), it's rendered as an internal link. Otherwise it's plain text.
 */

interface Props {
  homepage: string;
  pricingNotes?: string;
  alternatives?: string[];
  relatedPost?: string;
  relatedExperiment?: string;
}

const { homepage, pricingNotes, alternatives, relatedPost, relatedExperiment } = Astro.props;

// Detect "looks like a stack slug" — lowercase letters, digits, hyphens only
const isSlug = (s: string) => /^[a-z0-9-]+$/.test(s);
const prettyHome = homepage.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<aside class="my-12 rounded-2xl border border-border-subtle bg-bg-surface p-6 lg:p-8 space-y-6">
  <h3 class="text-[10px] font-mono uppercase tracking-[0.2em] text-accent">At a glance</h3>

  <div class="grid sm:grid-cols-2 gap-4">
    <!-- Homepage tile -->
    <div class="rounded-xl border border-border-subtle bg-bg-elevated p-4 space-y-1.5">
      <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted">Homepage</p>
      <a
        href={homepage}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-accent hover:text-text-primary transition-colors break-all"
      >
        {prettyHome} ↗
      </a>
    </div>

    {pricingNotes && (
      <div class="rounded-xl border border-border-subtle bg-bg-elevated p-4 space-y-1.5">
        <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted">Pricing</p>
        <p class="text-sm text-text-secondary leading-relaxed">{pricingNotes}</p>
      </div>
    )}

    {alternatives && alternatives.length > 0 && (
      <div class="rounded-xl border border-border-subtle bg-bg-elevated p-4 space-y-1.5 sm:col-span-2">
        <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted">Alternatives I'd consider</p>
        <p class="text-sm text-text-secondary">
          {alternatives.map((alt, i) => (
            <>
              {isSlug(alt) ? (
                <a href={`/stack/${alt}/`} class="text-accent hover:underline">{alt}</a>
              ) : (
                <span>{alt}</span>
              )}
              {i < alternatives.length - 1 && <span class="text-text-muted">, </span>}
            </>
          ))}
        </p>
      </div>
    )}

    {relatedPost && (
      <div class="rounded-xl border border-border-subtle bg-bg-elevated p-4 space-y-1.5">
        <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted">Related post</p>
        <a href={`/blog/${relatedPost}/`} class="text-sm text-accent hover:underline break-all">/blog/{relatedPost}</a>
      </div>
    )}

    {relatedExperiment && (
      <div class="rounded-xl border border-border-subtle bg-bg-elevated p-4 space-y-1.5">
        <p class="text-[10px] font-mono uppercase tracking-widest text-text-muted">Experiment</p>
        <a href={`/experiments/${relatedExperiment}/`} class="text-sm text-accent hover:underline break-all">/experiments/{relatedExperiment}</a>
      </div>
    )}
  </div>
</aside>
