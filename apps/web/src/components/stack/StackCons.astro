---
/**
 * StackCons.astro — Rose-accented "what it's bad at" bullet list
 *
 * Mirror of StackPros, with the danger accent. Mandatory on every entry —
 * Zod enforces .min(1) on the badAt array. This component is the visual
 * counterpart to that schema rule. If a reader sees only StackPros and no
 * StackCons, it's because either the rendering failed or the entry doesn't
 * exist yet (the Zod validation prevents the latter).
 */

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="my-8 space-y-3" aria-label="Limitations">
  <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-accent-danger">What it's bad at</h3>
  <ul class="space-y-2.5 list-none pl-0">
    {items.map(item => (
      <li class="flex items-start gap-3 text-text-secondary leading-relaxed">
        <span class="shrink-0 mt-1 text-accent-danger font-bold" aria-hidden="true">✗</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
