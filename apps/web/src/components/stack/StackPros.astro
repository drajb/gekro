---
/**
 * StackPros.astro — Emerald-accented "what it's good at" card
 *
 * Renders the goodAt array as a scannable card with a tinted header and check
 * glyphs. Designed to sit beside StackCons in a two-column grid (see
 * StackLayout) so a reader takes in the balance at a glance. h-full keeps both
 * cards the same height when grid-aligned.
 *
 * Bullets are plain text — markdown inside frontmatter is intentionally not
 * rendered here. If a bullet needs an inline link, write it in the post body.
 */

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div
  class="h-full rounded-2xl border border-accent-success/25 bg-accent-success/[0.04] p-6"
  aria-label="Strengths"
>
  <h3 class="flex items-center gap-2.5 text-xs font-mono uppercase tracking-[0.2em] text-accent-success mb-5">
    <span class="grid place-items-center w-6 h-6 rounded-full bg-accent-success/15 text-accent-success text-sm font-bold" aria-hidden="true">+</span>
    What it's good at
  </h3>
  <ul class="space-y-3.5 list-none pl-0">
    {items.map(item => (
      <li class="flex items-start gap-3 text-text-secondary leading-relaxed">
        <span class="shrink-0 mt-1 text-accent-success font-bold" aria-hidden="true">✓</span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
