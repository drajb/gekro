---
/**
 * StackVerdict.astro — The "bottom line up front" block at top of every entry
 *
 * Renders the 2-sentence verdict as a prominent quote-style card, followed by
 * the action row. Placement is critical — the verdict MUST be in the top
 * viewport per the stack-standard.md invariants.
 *
 * Action row (decision 2026-06-01, reverses 2026-05-31): the PRIMARY "Try"
 * button carries the referralLink when present, because that is where readers
 * actually look for it. It stays unlabelled (no "referral" badge) so it reads
 * as a clean CTA, not an ad — the muted <StackReferralFooter> remains the one
 * disclosure surface.
 *
 * The SECONDARY button: if the entry defines `altCta` (e.g. a self-built
 * alternative — "View my version"), that is shown, styled in the accent colour
 * so both buttons read as blue. Otherwise, when a referralLink exists, a plain
 * "Visit site" button points at the un-tracked homepage. With no referralLink
 * and no altCta, only the primary (homepage) button shows.
 */

interface Props {
  verdict: string;
  homepage: string;
  name: string;
  referralLink?: string;
  altCta?: { label: string; url: string };
}

const { verdict, homepage, name, referralLink, altCta } = Astro.props;
const primaryLink = referralLink ?? homepage;
---

<aside
  class="relative my-12 overflow-hidden rounded-2xl border-l-4 border-accent bg-bg-surface p-8 lg:p-10"
  aria-label="Verdict"
>
  <!-- Subtle accent glow in corner — matches TLDR.astro pattern -->
  <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-accent/5 blur-3xl"></div>

  <div class="relative z-10 space-y-7">
    <div class="space-y-4">
      <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-accent">The verdict</h2>
      <p class="text-lg lg:text-xl text-text-primary leading-relaxed italic">
        {verdict}
      </p>
    </div>

    <!-- Action row -->
    <div class="flex flex-wrap items-center gap-3 pt-1">
      <a
        href={primaryLink}
        target="_blank"
        rel="noopener noreferrer"
        class="app-btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm group"
      >
        Try {name}
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>

      {altCta ? (
        <a
          href={altCta.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-mono border border-accent text-accent hover:bg-accent/10 transition-colors group"
        >
          {altCta.label}
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      ) : referralLink && (
        <a
          href={homepage}
          target="_blank"
          rel="noopener noreferrer"
          class="app-btn-secondary inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm"
        >
          Visit site
        </a>
      )}
    </div>
  </div>
</aside>
