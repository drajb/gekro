---
/**
 * StackVerdict.astro — The "verdict" pull-quote block at top of every entry
 *
 * Renders the 2-sentence verdict from frontmatter as a prominent quote-style
 * block. Placement is critical — the verdict MUST be in the top viewport per
 * the stack-standard.md invariants. Buried verdicts are the format-DNA of
 * affiliate marketing; lead verdicts are the format-DNA of honest reviews.
 *
 * The "Try it" CTA beneath the verdict points at the tool's plain homepage -
 * NOT a referral link. This is deliberate (decision 2026-05-31): the prominent
 * top-of-page link is editorial, so a referral never overshadows the review's
 * voice. Referral links live only as subtle in-body prose links plus the muted
 * <StackReferralFooter> disclosure. See stack-standard.md section 6.
 */

interface Props {
  verdict: string;
  homepage: string;
}

const { verdict, homepage } = Astro.props;
---

<aside
  class="relative my-12 overflow-hidden rounded-2xl border-l-4 border-accent bg-bg-surface p-8 lg:p-10"
  aria-label="Verdict"
>
  <!-- Subtle accent glow in corner — matches TLDR.astro pattern -->
  <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-accent/5 blur-3xl"></div>

  <div class="relative z-10 space-y-6">
    <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-accent">Verdict</h2>
    <p class="text-lg lg:text-xl text-text-primary leading-relaxed italic">
      {verdict}
    </p>
    <a
      href={homepage}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm font-mono text-accent hover:text-text-primary transition-colors group"
    >
      Try it
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>
</aside>
