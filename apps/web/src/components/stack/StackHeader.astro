---
/**
 * StackHeader.astro — Top header block for a /stack entry
 *
 * Renders the tool name, category + status badges, tagline, and lastVerified
 * stamp. Sits at the top of every entry, above the verdict.
 *
 * Visual goal: identify in 2 seconds what tool this is, whether Rohit still
 * uses it, and how fresh the review is.
 */

interface Props {
  name: string;
  category: string;
  tagline: string;
  status: 'active' | 'watching' | 'dropped';
  lastVerified: string;
  priceTier: 'free' | 'paid-tier' | 'paid-only' | 'enterprise';
}

const { name, category, tagline, status, lastVerified, priceTier } = Astro.props;

// Status badge color + label
const statusConfig = {
  active:   { label: 'Active',   classes: 'bg-accent-success/10 text-accent-success border-accent-success/30' },
  watching: { label: 'Watching', classes: 'bg-accent-warm/10 text-accent-warm border-accent-warm/30' },
  dropped:  { label: 'Dropped',  classes: 'bg-accent-danger/10 text-accent-danger border-accent-danger/30' },
};

const priceLabel = {
  'free':       'Free',
  'paid-tier':  'Free tier + paid',
  'paid-only':  'Paid only',
  'enterprise': 'Enterprise',
}[priceTier];

// Format ISO date for display
const verifiedDate = new Date(lastVerified + 'T12:00:00').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

// Pretty category label
const categoryLabel = category.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<header class="space-y-6 pb-8 border-b border-border-subtle">
  <!-- Top badges row: category + status + price -->
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-[10px] uppercase font-mono tracking-widest text-text-muted border border-border px-2 py-1 rounded-full">
      {categoryLabel}
    </span>
    <span class={`text-[10px] uppercase font-mono tracking-widest px-2 py-1 rounded-full border ${statusConfig[status].classes}`}>
      {statusConfig[status].label}
    </span>
    <span class="text-[10px] uppercase font-mono tracking-widest text-text-muted border border-border px-2 py-1 rounded-full">
      {priceLabel}
    </span>
  </div>

  <!-- Name + tagline standfirst -->
  <div class="space-y-3">
    <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-text-primary tracking-tight">
      {name}
    </h1>
    <p class="text-lg sm:text-xl text-text-secondary leading-relaxed max-w-2xl">
      {tagline}
    </p>
  </div>

  <!-- Verified stamp -->
  <p class="text-[10px] uppercase font-mono tracking-widest text-text-muted">
    Last verified · {verifiedDate}
  </p>
</header>
