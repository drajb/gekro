---
/**
 * StackLayout.astro — Shell for individual /stack entry pages
 *
 * Extends BaseLayout and provides the structured top-to-bottom layout for a
 * tool review: header (name + badges) → verdict pull-quote → body content
 * (the slot, which renders markdown body) → meta block → referral footer →
 * back-to-stack link.
 *
 * Schema.org Review JSON-LD is emitted here so AI crawlers can pick up the
 * structured data. itemReviewed is SoftwareApplication; reviewRating is
 * derived from status:
 *   active   → rating 4.5
 *   watching → rating 3.5
 *   dropped  → rating 2.0
 *
 * Per the stack-standard.md:
 *  - Verdict block MUST appear in the top viewport (placed immediately under
 *    header, before the body slot).
 *  - Referral disclosure is the LAST element, muted, single line.
 *  - lastVerified shown in header (top of page).
 */

import BaseLayout from './BaseLayout.astro';
import JsonLD from '../components/seo/JsonLD.astro';
import StackHeader from '../components/stack/StackHeader.astro';
import StackVerdict from '../components/stack/StackVerdict.astro';
import StackPros from '../components/stack/StackPros.astro';
import StackCons from '../components/stack/StackCons.astro';
import StackMeta from '../components/stack/StackMeta.astro';
import StackReferralFooter from '../components/stack/StackReferralFooter.astro';
import ComparisonTable from '../components/stack/ComparisonTable.astro';
import SimpleBarChart from '../components/stack/SimpleBarChart.astro';

interface Props {
  entry: any; // CollectionEntry<'stack'> — typed loose here to avoid Astro type import friction
}

const { entry } = Astro.props;
const d = entry.data;
const slug = entry.slug;

const pageURL = `https://gekro.com/stack/${slug}/`;

// Status → review rating mapping for schema.org/Review
const ratingByStatus = { active: 4.5, watching: 3.5, dropped: 2.0 };
const reviewRating = ratingByStatus[d.status as keyof typeof ratingByStatus];

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "@id": `${pageURL}#review`,
  "itemReviewed": {
    "@type": "SoftwareApplication",
    "name": d.name,
    "url": d.homepage,
    "applicationCategory": d.category,
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": reviewRating,
    "bestRating": 5,
    "worstRating": 1,
  },
  "author": {
    "@type": "Person",
    "@id": "https://gekro.com/about/#person",
    "name": "Rohit Burani",
    "url": "https://gekro.com/about/",
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://gekro.com/#organization",
    "name": "gekro",
    "url": "https://gekro.com",
  },
  "datePublished": d.publishedAt,
  "dateModified": d.lastVerified,
  "reviewBody": d.verdict,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageURL },
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://gekro.com/" },
    { "@type": "ListItem", "position": 2, "name": "Stack", "item": "https://gekro.com/stack/" },
    { "@type": "ListItem", "position": 3, "name": d.name, "item": pageURL },
  ],
};

// SEO description: verdict is already the best 1-2 sentence summary
const seoDescription = d.aiSummary || d.verdict;
// Per-entry OG card — generated by /og/stack/[slug].png.ts at build time.
// Mirrors the blog OG pattern so stack reviews share well to social media.
const ogImage = `/og/stack/${slug}.png`;
---

<BaseLayout
  title={`${d.name} review`}
  description={seoDescription}
  ogImage={ogImage}
  ogType="article"
  publishedTime={d.publishedAt}
  modifiedTime={d.lastVerified}
  author="Rohit Burani"
  section={d.category}
>
  <JsonLD data={reviewSchema} />
  <JsonLD data={breadcrumbs} />

  <article class="max-w-4xl mx-auto px-6 py-24">
    <!-- Header: name, badges, tagline, verified date -->
    <StackHeader
      name={d.name}
      category={d.category}
      tagline={d.tagline}
      status={d.status}
      lastVerified={d.lastVerified}
      priceTier={d.priceTier}
    />

    <!-- Optional dropped-reason callout — only shown when status is dropped -->
    {d.status === 'dropped' && d.droppedReason && (
      <aside class="my-8 p-6 border-l-4 border-accent-danger bg-accent-danger/5 rounded-r-xl" aria-label="Dropped">
        <p class="text-xs font-mono uppercase tracking-[0.2em] text-accent-danger mb-2">Dropped</p>
        <p class="text-text-secondary leading-relaxed">{d.droppedReason}</p>
      </aside>
    )}

    <!-- Verdict pull-quote — MUST be in top viewport per stack-standard.md -->
    <StackVerdict verdict={d.verdict} homepage={d.homepage} name={d.name} referralLink={d.referralLink} altCta={d.altCta} />

    <!-- Pros / cons — side-by-side cards, emerald + rose color-coded -->
    <section class="my-12">
      <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-text-muted mb-5">The good and the bad</h2>
      <div class="grid md:grid-cols-2 gap-5 items-stretch">
        <StackPros items={d.goodAt} />
        <StackCons items={d.badAt} />
      </div>
    </section>

    <!-- Optional "How it compares" section — driven by frontmatter so .md files
         stay portable (no MDX needed). If neither table nor chart is set, the
         section is skipped entirely; if either is set, the heading renders. -->
    {(d.comparisonTable || d.barChart) && (
      <section class="my-10">
        <h2 class="text-2xl font-heading text-text-primary border-b border-border-subtle pb-3 mb-6">
          How it compares
        </h2>
        {d.comparisonTable && (
          <ComparisonTable
            headers={d.comparisonTable.headers}
            rows={d.comparisonTable.rows}
            highlight={d.comparisonTable.highlight}
            caption={d.comparisonTable.caption}
          />
        )}
        {d.barChart && (
          <SimpleBarChart
            title={d.barChart.title}
            unit={d.barChart.unit}
            bars={d.barChart.bars}
            source={d.barChart.source}
            max={d.barChart.max}
          />
        )}
      </section>
    )}

    <!-- Markdown body — rendered by entry.render() in the parent page -->
    <div class="prose prose-invert max-w-none
                prose-headings:font-heading prose-headings:font-medium prose-headings:text-text-primary
                prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-3 prose-h2:border-b prose-h2:border-border-subtle
                prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                prose-p:text-text-secondary prose-p:leading-relaxed
                prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                prose-strong:text-text-primary prose-strong:font-semibold
                prose-code:text-accent/90 prose-code:bg-bg-elevated prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
                prose-pre:bg-bg-surface prose-pre:border prose-pre:border-border-subtle prose-pre:rounded-xl
                prose-li:text-text-secondary">
      <slot />
    </div>

    <!-- At-a-glance meta: homepage, pricing, alternatives, cross-links -->
    <StackMeta
      homepage={d.homepage}
      pricingNotes={d.pricingNotes}
      alternatives={d.alternatives}
      relatedPost={d.relatedPost}
      relatedExperiment={d.relatedExperiment}
    />

    <!-- Back to /stack index -->
    <div class="mt-8 pt-6 border-t border-border-subtle">
      <a href="/stack/" class="inline-flex items-center gap-2 text-sm font-mono text-text-muted hover:text-accent transition-colors group">
        <span class="transition-transform group-hover:-translate-x-1">←</span>
        Back to stack
      </a>
    </div>

    <!-- The ONLY disclosure surface — single muted line, fine-print style -->
    <StackReferralFooter hasReferral={Boolean(d.referralLink)} />
  </article>
</BaseLayout>
