---
/**
 * /news/[slug] — individual daily briefing
 *
 * Slug is the date (2026-06-02 → /news/2026-06-02/). Renders the headline,
 * a subtle dateline, the inline-cited body, a sources footer, and prev/next.
 * Mobile-first typography.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLD from '../../components/seo/JsonLD.astro';

export async function getStaticPaths() {
  const briefings = await getCollection('news', b => b.data.approved);
  return briefings.map(b => ({ params: { slug: b.id }, props: { briefing: b } }));
}

const { briefing } = Astro.props;
const { Content } = await render(briefing);

const dateline = new Date(briefing.data.publishedAt + 'T12:00:00Z').toLocaleDateString('en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
});

const all = (await getCollection('news', b => b.data.approved))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
const idx = all.findIndex(b => b.id === briefing.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx < all.length - 1 ? all[idx + 1] : null;

const uniqueSources = [...new Map(
  briefing.data.sources.map((name: string, i: number): [string, { name: string; url: string }] => [briefing.data.sourceUrls[i] ?? name, { name, url: briefing.data.sourceUrls[i] }])
).values()];

const pageURL = `https://gekro.com/news/${briefing.id}/`;
const ogImage = `/og/news/${briefing.id}.png`;

// Plain-text article body for the NewsArticle JSON-LD. Many AI engines and
// crawlers read schema.org `articleBody` directly — without it they only see
// the headline + 1-sentence description (which is exactly why assistants like
// Grok were returning "just the title"). Strip markdown to clean prose.
const plainBody = (briefing.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/[#>*_`~]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const wordCount = plainBody ? plainBody.split(/\s+/).length : 0;
const readMins = Math.max(1, Math.round(wordCount / 200));

// schema.org NewsArticle — news is the most citation/GEO-sensitive content type
const newsSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "@id": `${pageURL}#article`,
  "headline": briefing.data.title,
  "description": briefing.data.summary,
  // Google requires `image` for Article-family rich results — the per-briefing
  // OG card already exists, so point at it.
  "image": [`https://gekro.com${ogImage}`],
  "datePublished": briefing.data.publishedAt,
  "dateModified": briefing.data.publishedAt,
  "author": {
    "@type": "Person",
    "@id": "https://gekro.com/about/#person",
    "name": "Rohit Burani",
    "url": "https://gekro.com/about/",
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://gekro.com/#organization",
    "name": "gekro",
    "url": "https://gekro.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://gekro.com/favicon.svg",
      "width": 256,
      "height": 256,
    },
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageURL },
  "isAccessibleForFree": true,
  "articleSection": "Artificial Intelligence",
  "inLanguage": "en-US",
  // Full article text + the sources it's based on, so AI engines / crawlers
  // that read structured data get the whole briefing and its citations — not
  // just the headline. This is the core fix for "AI only reads the title".
  "articleBody": plainBody,
  "wordCount": wordCount,
  "citation": uniqueSources.map(s => ({ "@type": "CreativeWork", name: s.name, url: s.url })),
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://gekro.com/" },
    { "@type": "ListItem", "position": 2, "name": "News", "item": "https://gekro.com/news/" },
    { "@type": "ListItem", "position": 3, "name": briefing.data.title, "item": pageURL },
  ],
};
---

<BaseLayout
  title={`${briefing.data.title} | gekro`}
  description={briefing.data.summary}
  ogImage={ogImage}
  ogType="article"
  publishedTime={briefing.data.publishedAt}
  modifiedTime={briefing.data.publishedAt}
  author="Rohit Burani"
  section="AI News"
>
  <JsonLD data={newsSchema} />
  <JsonLD data={breadcrumbs} />
  <main class="max-w-2xl mx-auto px-5 sm:px-6 pt-28 sm:pt-32 pb-24">

    <a href="/news/" class="inline-flex items-center gap-1.5 text-[11px] font-mono text-text-muted hover:text-accent transition-colors mb-8">
      ← News Feed
    </a>

    <!-- Headline + dateline -->
    <header class="mb-8">
      <div class="flex items-center gap-2.5 mb-3">
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-accent">AI News</span>
      </div>
      <h1 class="text-2xl sm:text-[1.85rem] font-heading font-medium tracking-tight text-text-primary leading-tight mb-3">
        {briefing.data.title}
      </h1>
      <p class="text-[12px] font-mono text-text-muted flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <time datetime={briefing.data.publishedAt}>{dateline}</time>
        <span class="text-border-subtle" aria-hidden="true">·</span>
        <span>{readMins} min read</span>
        <span class="text-border-subtle" aria-hidden="true">·</span>
        <span>{uniqueSources.length} source{uniqueSources.length === 1 ? '' : 's'}</span>
      </p>
    </header>

    <!-- TL;DR: scannable takeaway up top (also a clean summary block for SEO/AI) -->
    <div class="mb-9 p-4 sm:p-5 bg-bg-elevated border border-border-subtle rounded-xl">
      <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-accent mb-2">The gist</p>
      <p class="text-[15px] sm:text-base text-text-primary leading-relaxed">{briefing.data.summary}</p>
    </div>

    <!-- Body (inline citations render as accent links) -->
    <article class="prose prose-invert max-w-none
      prose-p:text-text-secondary prose-p:leading-[1.75] prose-p:text-[15px] sm:prose-p:text-[16px] prose-p:mb-6
      prose-strong:text-text-primary prose-strong:font-semibold
      prose-a:text-accent prose-a:font-normal prose-a:no-underline prose-a:border-b prose-a:border-accent/30 hover:prose-a:border-accent
    ">
      <Content />
    </article>

    <!-- Sources -->
    {uniqueSources.length > 0 && (
      <footer class="mt-10 pt-7 border-t border-border-subtle">
        <p class="text-[10px] font-mono uppercase tracking-[0.15em] text-text-muted mb-3">Sources</p>
        <ul class="space-y-2">
          {uniqueSources.map(s => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-baseline gap-1.5 text-[13px] font-mono text-text-secondary hover:text-accent transition-colors break-all"
              >
                <span class="text-text-muted group-hover:text-accent flex-shrink-0">↗</span>
                <span>{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[10px] font-mono text-text-muted leading-relaxed">
          Compiled automatically from the linked sources and published without manual editing. A neutral summary of third-party reporting, for information only - every claim links to its origin; follow those for the full story. Not original reporting.
        </p>
      </footer>
    )}

    <!-- Prev / Next -->
    <nav class="mt-10 pt-7 border-t border-border-subtle flex justify-between gap-4 text-[12px] font-mono">
      {older ? (
        <a href={`/news/${older.id}/`} class="group text-text-muted hover:text-accent transition-colors max-w-[45%]">
          <span class="block text-[10px] uppercase tracking-widest text-text-muted/60 mb-1">← Older</span>
          <span class="block leading-snug line-clamp-2 group-hover:text-accent">{older.data.title}</span>
        </a>
      ) : <span />}
      {newer ? (
        <a href={`/news/${newer.id}/`} class="group text-text-muted hover:text-accent transition-colors max-w-[45%] text-right ml-auto">
          <span class="block text-[10px] uppercase tracking-widest text-text-muted/60 mb-1">Newer →</span>
          <span class="block leading-snug line-clamp-2 group-hover:text-accent">{newer.data.title}</span>
        </a>
      ) : <span />}
    </nav>

  </main>
</BaseLayout>
