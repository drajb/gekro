---
/**
 * /news — AI industry news feed
 *
 * A flowing reverse-chronological feed of daily AI briefings. Newest at the
 * top; older entries flow downstream. Each entry leads with a real news
 * headline (not a date), with the date as a subtle timestamp. Mobile-first.
 *
 * Briefings are generated daily by the "Daily AI News Briefing" cloud
 * routine (.claude/commands/news-briefing.md) and published after the
 * routine's own build-validation. Every claim in a briefing is inline-cited.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const feed = (await getCollection('news'))
  .filter(b => b.data.approved)
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

const fmtDate = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// "2 days ago" style relative label for the freshest few
const relative = (iso: string): string => {
  const days = Math.round((Date.now() - new Date(iso + 'T12:00:00Z').getTime()) / 86_400_000);
  if (days <= 0) return 'Today';
  if (days === 1) return 'Yesterday';
  if (days < 7) return `${days} days ago`;
  return fmtDate(iso);
};
---

<BaseLayout
  title="AI News — Daily Briefings | gekro"
  description="Daily AI industry news, neutral and cited. The signal an engineer needs to stay caught up - model releases, research, infra, pricing - summarized from vetted sources with every claim linked to its origin."
>
  <main class="max-w-2xl mx-auto px-5 sm:px-6 pt-28 sm:pt-32 pb-24">

    <!-- Masthead -->
    <header class="mb-10 sm:mb-12">
      <div class="flex items-center gap-2.5 mb-3">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-muted">AI News · Updated daily</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-heading font-medium tracking-tight text-text-primary mb-3">
        News Feed
      </h1>
      <p class="text-[14px] sm:text-[15px] text-text-secondary leading-relaxed">
        The latest in AI, summarized and sourced.
      </p>
      <div class="mt-3 flex items-center gap-3 text-[11px] font-mono text-text-muted">
        <a href="/news-rss.xml" class="hover:text-accent transition-colors">RSS</a>
        <span class="text-border-subtle">·</span>
        <span>{feed.length} briefing{feed.length === 1 ? '' : 's'}</span>
      </div>
    </header>

    <!-- Feed -->
    {feed.length === 0 ? (
      <p class="text-text-muted font-mono text-sm">No briefings yet. The first one publishes soon.</p>
    ) : (
      <div class="relative">
        <!-- Vertical timeline rail (hidden on the smallest screens) -->
        <div class="hidden sm:block absolute left-[5px] top-2 bottom-2 w-px bg-border-subtle" aria-hidden="true"></div>

        <ol class="space-y-8 sm:space-y-10">
          {feed.map((item, i) => (
            <li class="relative sm:pl-8">
              <!-- Timeline dot -->
              <span
                class={`hidden sm:block absolute left-0 top-2 w-[11px] h-[11px] rounded-full border-2 ${i === 0 ? 'bg-accent border-accent' : 'bg-bg-base border-border'}`}
                aria-hidden="true"
              ></span>

              <a href={`/news/${item.slug}/`} class="group block">
                <!-- Timestamp + freshness -->
                <div class="flex items-center gap-2.5 mb-2">
                  <time datetime={item.data.publishedAt} class="text-[11px] font-mono text-text-muted">
                    {relative(item.data.publishedAt)}
                  </time>
                  {i === 0 && (
                    <span class="text-[9px] font-mono uppercase tracking-widest text-accent bg-accent/10 border border-accent/20 px-1.5 py-0.5 rounded-full">
                      Latest
                    </span>
                  )}
                </div>

                <!-- Headline -->
                <h2 class="text-lg sm:text-xl font-heading font-medium text-text-primary leading-snug group-hover:text-accent transition-colors mb-2">
                  {item.data.title}
                </h2>

                <!-- Dek / summary -->
                <p class="text-[14px] text-text-secondary leading-relaxed">
                  {item.data.summary}
                </p>

                <!-- Source chips + read link -->
                <div class="mt-3 flex items-center justify-between gap-3">
                  <div class="flex flex-wrap gap-1.5 min-w-0">
                    {[...new Set(item.data.sources)].slice(0, 4).map(src => (
                      <span class="text-[10px] font-mono text-text-muted bg-bg-elevated border border-border-subtle px-2 py-0.5 rounded-full whitespace-nowrap">
                        {src}
                      </span>
                    ))}
                  </div>
                  <span class="flex-shrink-0 text-[11px] font-mono text-text-muted group-hover:text-accent transition-colors">
                    Read →
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>
    )}

    <!-- Footer note -->
    <p class="mt-16 pt-8 border-t border-border-subtle text-[11px] font-mono text-text-muted leading-relaxed">
      Summarized from vetted sources, every claim linked. For information only.
    </p>
  </main>
</BaseLayout>
