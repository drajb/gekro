export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map(app => ({ params: { slug: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);

const today = new Date().toISOString().split('T')[0];
const exportFilename = `${app.id}-${today}.csv`;

const Calculator = CALCULATOR_MAP[app.id];
---

<AppLayout app={app}>
  <AppShell
    title={app.data.title}
    job={app.data.job}
    category={app.data.category}
    slug={app.id}
    lastVerified={app.data.lastVerified}
    companionPostSlug={app.data.companionPostSlug}
    license={app.data.license}
    exportFilename={exportFilename}
  >
    {Calculator ? (
      <Calculator />
    ) : (
      <div class="py-16 text-center border border-dashed border-border rounded-xl">
        <p class="text-text-muted font-mono text-sm">Calculator coming soon.</p>
      </div>
    )}
  </AppShell>

  <div slot="methodology">
    <Content />
  </div>
</AppLayout>
