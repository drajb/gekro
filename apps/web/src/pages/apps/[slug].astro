---
/**
 * apps/[slug].astro — Individual tool page (/apps/[slug])
 *
 * Static generation: one page per tool in the `apps` content collection. Browser
 * games share the collection but live under /games/[slug] (pages/games/[slug].astro),
 * so they are skipped here (lib/utils/games.ts is the registry).
 * Each tool maps to a Calculator component via CALCULATOR_MAP
 * (components/apps/calculator-map.ts).
 * The markdown body (methodology + sources + limitations) is rendered below
 * the calculator via the AppLayout "methodology" named slot.
 *
 * Adding a new tool:
 *  1. Create apps/web/src/content/apps/{slug}.md  (public repo — metadata)
 *  2. Create {slug}/Calculator.astro in drajb/gekro-apps, then commit + push there
 *     (private repo — implementation). apps-private is NOT a submodule: it's
 *     gitignored and cloned fresh at build time (HEAD of main), so there is no
 *     ref to update here.
 *  3. Add one import + one entry to components/apps/calculator-map.ts. The next
 *     build clones HEAD of gekro-apps automatically and picks up the Calculator.
 */

import { getCollection, render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import AppShell from '../../components/apps/AppShell.astro';
import { CALCULATOR_MAP } from '../../components/apps/calculator-map';
import { isGame } from '../../lib/utils/games';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ id }) => !isGame(id));
  return apps.map(app => ({ params: { slug: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);

const today = new Date().toISOString().split('T')[0];
const exportFilename = `${app.id}-${today}.csv`;

const Calculator = CALCULATOR_MAP[app.id];
---

<AppLayout app={app}>
  <AppShell
    title={app.data.title}
    job={app.data.job}
    category={app.data.category}
    slug={app.id}
    lastVerified={app.data.lastVerified}
    companionPostSlug={app.data.companionPostSlug}
    license={app.data.license}
    exportFilename={exportFilename}
  >
    {Calculator ? (
      <Calculator />
    ) : (
      <div class="py-16 text-center border border-dashed border-border rounded-xl">
        <p class="text-text-muted font-mono text-sm">Calculator coming soon.</p>
      </div>
    )}
  </AppShell>

  <div slot="methodology">
    <Content />
  </div>
</AppLayout>
