---
/**
 * games/[slug].astro — Individual game page (/games/[slug])
 *
 * Games are entries in the `apps` content collection (guide markdown) whose slug is
 * listed in lib/utils/games.ts. They moved here from /apps/[slug] on 2026-11-05;
 * public/_redirects 301s the old URLs. The page reuses AppLayout and AppShell,
 * which pick the games wording and links from the same registry.
 *
 * Adding a game: guide in content/apps/{slug}.md, implementation in the private
 * gekro-apps repo, one entry in lib/utils/games.ts (slug -> genre), one import and
 * entry in components/apps/calculator-map.ts.
 */

import { getCollection, render } from 'astro:content';
import AppLayout from '../../layouts/AppLayout.astro';
import AppShell from '../../components/apps/AppShell.astro';
import { CALCULATOR_MAP } from '../../components/apps/calculator-map';
import { isGame } from '../../lib/utils/games';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ id }) => isGame(id));
  return apps.map(app => ({ params: { slug: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);

const today = new Date().toISOString().split('T')[0];
const exportFilename = `${app.id}-${today}.csv`;

const Calculator = CALCULATOR_MAP[app.id];
---

<AppLayout app={app}>
  <AppShell
    title={app.data.title}
    job={app.data.job}
    category={app.data.category}
    slug={app.id}
    lastVerified={app.data.lastVerified}
    companionPostSlug={app.data.companionPostSlug}
    license={app.data.license}
    exportFilename={exportFilename}
  >
    {Calculator ? (
      <Calculator />
    ) : (
      <div class="py-16 text-center border border-dashed border-border rounded-xl">
        <p class="text-text-muted font-mono text-sm">This game is coming soon.</p>
      </div>
    )}
  </AppShell>

  <div slot="methodology">
    <Content />
  </div>
</AppLayout>
