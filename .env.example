# Sanity
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Organization
ORGANIZATION_ID=

# Giscus (GitHub Discussions comments)
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=

# Beehiiv Newsletter
# Find at app.beehiiv.com → Settings → Publication → Publication ID
PUBLIC_BEEHIIV_PUBLICATION_ID=

# Cloudflare Turnstile (Contact form CAPTCHA)
PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics & Tag Manager
PUBLIC_GA_MEASUREMENT_ID=

# Search engine ownership verification (added 2026-05-15)
# Set these in Cloudflare Pages → Variables and Secrets after verifying
# ownership at the respective consoles. Redeploy, then verify in the console.
# GSC: search.google.com/search-console → Add property → meta-tag method.
# Bing: bing.com/webmasters → Add site → meta-tag method.
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
